<?php

namespace App\Notifications;

use Illuminate\Bus\Queueable;
use Illuminate\Notifications\Messages\MailMessage;
use Illuminate\Notifications\Notification;

class GuestCancellationDecision extends Notification
{
    use Queueable;

    public function __construct(
        protected $appointment,
        protected string $decision
    ) {
    }

    public function via(object $notifiable): array
    {
        return ['mail'];
    }

    public function toMail(object $notifiable): MailMessage
    {
        $approved = $this->decision === 'approved';
        $date = $this->appointment->appointment_date
            ? $this->appointment->appointment_date->format('F d, Y')
            : 'Not specified';
        $time = $this->appointment->appointment_time ?: 'Not specified';
        $name = $this->appointment->patient?->patient_name ?: 'Patient';

        return (new MailMessage)
            ->subject($approved
                ? 'Cancellation Request Approved - Shine & Smile Dental'
                : 'Cancellation Request Declined - Shine & Smile Dental')
            ->greeting('Hello ' . $name . ',')
            ->line($approved
                ? 'The clinic has approved your cancellation request. Your appointment is now cancelled.'
                : 'The clinic has declined your cancellation request. Your appointment remains confirmed.')
            ->line('Appointment date: ' . $date)
            ->line('Appointment time: ' . $time)
            ->salutation('Thank you, Shine & Smile Dental');
    }
}
