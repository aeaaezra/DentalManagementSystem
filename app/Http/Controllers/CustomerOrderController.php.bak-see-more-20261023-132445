    public function orders()
    {
        $customer = Customer::where('email', auth()->user()->email)->first();

        $orders = $customer
            ? Orders::with('items.product')
                ->where('customer_id', $customer->id)
                ->latest('order_date')
                ->get()
            : collect();

        return view('customer.orders', compact('orders'));
    }


