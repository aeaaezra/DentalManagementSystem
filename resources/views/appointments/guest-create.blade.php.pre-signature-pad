<script id="guest-slot-script">
document.addEventListener('DOMContentLoaded', function () {
    const service = document.getElementById('service_id');
    const date = document.getElementById('appointment_date');
    const slotsBox = document.getElementById('guest-time-slots');
    const timeInput = document.getElementById('appointment_time');
    const endInput = document.getElementById('end_time');
    const selectionText = document.getElementById('guest-slot-selection');
    const serviceInfo = document.getElementById('guest-service-info');
    const oldTime = timeInput.value;

    function showMessage(message) {
        slotsBox.replaceChildren();
        const p = document.createElement('p');
        p.className = 'slot-message';
        p.textContent = message;
        slotsBox.appendChild(p);
    }

    function clearSelection() {
        timeInput.value = '';
        endInput.value = '';
        selectionText.textContent = 'No time selected.';
    }

    function updateServiceInfo() {
        const option = service.options[service.selectedIndex];
        if (!option || !option.value) {
            serviceInfo.textContent = 'Choose a service to see its price and duration.';
            return;
        }

        const price = Number(option.dataset.price || 0);
        const duration = Number(option.dataset.duration || 0);
        serviceInfo.textContent =
            'Price: ₱' + price.toLocaleString('en-PH', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) + ' · Duration: ' + duration + ' minutes';
    }

    async function loadGuestSlots() {
        clearSelection();

        if (!service.value) {
            showMessage('Select a dental service first.');
            return;
        }

        if (!date.value) {
            showMessage('Choose an appointment date to see available times.');
            return;
        }

        const option = service.options[service.selectedIndex];
        if (!Number(option.dataset.duration || 0)) {
            showMessage('This service has no valid duration. Please contact the clinic.');
            return;
        }

        showMessage('Loading available time slots…');

        try {
            const url = new URL('/available-slots', window.location.origin);
            url.searchParams.set('date', date.value);
            url.searchParams.set('service_id', service.value);

            const response = await fetch(url.toString(), {
                headers: { 'Accept': 'application/json' }
            });

            if (!response.ok) {
                throw new Error('Availability request failed.');
            }

            const data = await response.json();
            slotsBox.replaceChildren();

            if (!Array.isArray(data) || data.length === 0) {
                showMessage('No time slots are available for this service and date.');
                return;
            }

            let oldTimeFound = false;

            data.forEach(function (slot) {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'slot-btn';
                button.textContent = slot.time;
                button.disabled = !slot.available;
                button.setAttribute(
                    'aria-label',
                    slot.time + (slot.available ? ', available' : ', unavailable')
                );

                if (!slot.available) {
                    button.title = 'This time is unavailable';
                }

                if (slot.available) {
                    button.addEventListener('click', function () {
                        slotsBox.querySelectorAll('.slot-btn.active').forEach(function (active) {
                            active.classList.remove('active');
                        });

                        button.classList.add('active');
                        timeInput.value = slot.start;
                        endInput.value = slot.end;
                        selectionText.textContent =
                            'Selected: ' + slot.time + ' · ' +
                            Number(slot.duration || 0) + ' minutes';
                    });

                    if (oldTime && slot.start === oldTime) {
                        oldTimeFound = true;
                        button.classList.add('active');
                        timeInput.value = slot.start;
                        endInput.value = slot.end;
                        selectionText.textContent =
                            'Selected: ' + slot.time + ' · ' +
                            Number(slot.duration || 0) + ' minutes';
                    }
                }

                slotsBox.appendChild(button);
            });

            if (oldTime && !oldTimeFound) {
                clearSelection();
                selectionText.textContent =
                    'Your previous time is no longer available. Please choose another.';
            }
        } catch (error) {
            showMessage('Unable to load time slots. Please refresh and try again.');
        }
    }

    service.addEventListener('change', function () {
        updateServiceInfo();
        loadGuestSlots();
    });

    date.addEventListener('change', loadGuestSlots);

    const form = service.closest('form');
    form.addEventListener('submit', function (event) {
        if (!timeInput.value || !endInput.value) {
            event.preventDefault();
            selectionText.textContent = 'Please select an available time slot.';
            slotsBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    updateServiceInfo();

    if (service.value && date.value) {
        loadGuestSlots();
    } else {
        showMessage('Select a dental service and date to see available times.');
    }
});
</script>

