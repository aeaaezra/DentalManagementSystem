    <template x-if="showModal">

        <div>

            <div
                class="twofa-modal-overlay"
                @click="closeModal()"
                aria-hidden="true"
            ></div>

            <div
                class="twofa-modal-wrapper"
                role="dialog"
                aria-modal="true"
                aria-labelledby="twofa-title"
            >

                <div
                    x-ref="twofaModal"
                    class="twofa-modal"
                    @click.stop
                >

                    <div class="twofa-modal-header">

                        <div>

                            <h2
                                id="twofa-title"
                                class="twofa-modal-title"
                            >
                                Set Up Two-Factor Authentication
                            </h2>

                            <p class="twofa-modal-subtitle">
                                Secure your administrator account with Google Authenticator.
                            </p>

                        </div>

                        <button
                            type="button"
                            class="twofa-close"
                            @click="closeModal()"
                            aria-label="Close"
                        >
                            ×
                        </button>

                    </div>


                    <div class="twofa-modal-body">

                        <p class="twofa-instructions">

                            <strong>1.</strong>
                            Open Google Authenticator on your phone.
                            <br>

                            <strong>2.</strong>
                            Scan the QR code below.
                            <br>

                            <strong>3.</strong>
                            Enter the 6-digit verification code generated by the app.

                        </p>


                        {{-- QR CODE --}}

                        <template x-if="qrCode">

                            <div class="twofa-qr-container">

                                <img
                                    :src="qrCode"
                                    alt="Google Authenticator QR Code"
                                    draggable="false"
                                >

                            </div>

                        </template>


                        {{-- LOADING QR --}}

                        <div
                            x-show="!qrCode && !error"
                            style="text-align:center;padding:25px;color:#6b7280;font-size:13px;"
                        >
                            Generating your secure QR code...
                        </div>


                        {{-- SECRET --}}

                        <div
                            class="twofa-manual-key"
                            x-show="secret"
                        >

                            <span class="twofa-manual-key-label">
                                Manual setup key
                            </span>

                            <div class="twofa-secret-row">

                                <div
                                    class="twofa-secret"
                                    x-text="secret"
                                ></div>

                                <button
                                    type="button"
                                    class="twofa-copy-button"
                                    @click="copySecret()"
                                    :disabled="!secret"
                                >
                                    <span x-show="!copied">
                                        Copy
                                    </span>

                                    <span x-show="copied">
                                        ✓ Copied
                                    </span>
                                </button>

                            </div>

                        </div>


                        {{-- OTP --}}

                        <div>

                            <label
                                for="twofa-authentication-code"
                                class="twofa-label"
                            >
                                Authentication Code
                            </label>

                            <input
                                id="twofa-authentication-code"
                                x-ref="otpInput"
                                type="text"
                                inputmode="numeric"
                                autocomplete="one-time-code"
                                maxlength="6"
                                class="twofa-input"
                                x-model="otp"
                                @input="otp = otp.replace(/[^0-9]/g, '').slice(0, 6)"
                                @keydown.enter.prevent="verifyTwoFactor()"
                                placeholder="000000"
                                required
                            >

                            <div
                                style="margin-top:7px;color:#6b7280;font-size:12px;text-align:center;"
                            >
                                Enter the current 6-digit code from Google Authenticator.
                            </div>

                        </div>


                        {{-- ERROR --}}

                        <div
                            class="twofa-error"
                            x-show="error"
                            x-text="error"
                            role="alert"
                        ></div>


                        {{-- SUCCESS --}}

                        <div
                            class="twofa-success"
                            x-show="success"
                            x-text="success"
                            role="status"
                        ></div>


                        {{-- ACTIONS --}}

                        <div class="twofa-actions">

                            <button
                                type="button"
                                class="ss-pink-button"
                                @click="verifyTwoFactor()"
                                :disabled="verifying || otp.length !== 6"
                            >

                                <span x-show="!verifying">
                                    Verify & Enable
                                </span>

                                <span x-show="verifying">

                                    <span class="twofa-spinner"></span>

                                    Verifying...

                                </span>

                            </button>


                            <button
                                type="button"
                                class="ss-danger-button"
                                @click="closeModal()"
                                :disabled="verifying"
                            >
                                Cancel
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </template>

