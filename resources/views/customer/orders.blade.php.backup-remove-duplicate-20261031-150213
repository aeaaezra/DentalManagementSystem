<!-- Shopee-inspired cancellation form -->
<div class="cancel-modal" id="cancelModal" aria-hidden="true">
    <div class="cancel-modal__backdrop" data-close-cancel></div>

    <section class="cancel-modal__panel" role="dialog"
             aria-modal="true" aria-labelledby="cancelTitle">
        <button type="button" class="cancel-modal__close" data-close-cancel
                aria-label="Close cancellation form">×</button>

        <h2 id="cancelTitle">Cancel Order</h2>
        <p class="cancel-modal__intro">Please select a reason for cancelling this order.</p>

        <form id="cancelOrderForm">
            <input type="hidden" name="order_id" id="cancelOrderId">

            <fieldset>
                <legend>Reason for Cancellation</legend>

                <label class="cancel-option">
                    <input type="radio" name="reason" value="I want to change my order" required>
                    <span>I want to change my order (size, color, etc.)</span>
                </label>
                <label class="cancel-option">
                    <input type="radio" name="reason" value="I want to add or remove an item">
                    <span>I want to add or remove an item</span>
                </label>
                <label class="cancel-option">
                    <input type="radio" name="reason" value="I found a better price elsewhere">
                    <span>I found a better price elsewhere</span>
                </label>
                <label class="cancel-option">
                    <input type="radio" name="reason" value="The delivery process is too slow">
                    <span>The delivery process is too slow</span>
                </label>
                <label class="cancel-option">
                    <input type="radio" name="reason" value="I no longer need this order">
                    <span>I no longer need this order</span>
                </label>
                <label class="cancel-option">
                    <input type="radio" name="reason" value="Payment issue">
                    <span>Payment issue</span>
                </label>
                <label class="cancel-option">
                    <input type="radio" name="reason" value="Other">
                    <span>Other (please specify)</span>
                </label>
            </fieldset>

            <label class="cancel-details-label" for="cancelDetails">
                Additional details <span>(optional)</span>
            </label>
            <textarea id="cancelDetails" name="details"
                      placeholder="Type your reason here..." rows="3"></textarea>

            <div class="cancel-modal__actions">
                <button type="button" class="cancel-button cancel-button--outline"
                        data-close-cancel>Back</button>
                <button type="submit" class="cancel-button cancel-button--primary"
                        id="submitCancel" disabled>Submit Request</button>
            </div>
        </form>
    </section>
</div>

<style>
.cancel-modal[aria-hidden="true"] { display: none; }
.cancel-modal {
    position: fixed; inset: 0; z-index: 9999;
    display: grid; place-items: center; padding: 16px;
    font-family: Arial, sans-serif;
}
.cancel-modal__backdrop {
    position: absolute; inset: 0;
    background: rgba(25,15,22,.58); backdrop-filter: blur(5px);
}
.cancel-modal__panel {
    position: relative; width: min(100%,560px); max-height: 90vh;
    overflow-y: auto; padding: 30px; border-radius: 22px;
    background: #fff8fb; box-shadow: 0 18px 60px rgba(40,10,25,.25);
}
.cancel-modal__close {
    position: absolute; top: 16px; right: 18px; width: 38px; height: 38px;
    border: 0; border-radius: 50%; background: #ffe2ee;
    color: #e91e63; font-size: 26px; cursor: pointer;
}
.cancel-modal h2 { margin: 8px 40px 10px 0; color: #e91e63; font-size: 27px; }
.cancel-modal__intro { margin: 0 0 22px; color: #74616c; }
.cancel-modal fieldset { margin: 0; padding: 0; border: 0; }
.cancel-modal legend { margin-bottom: 10px; font-weight: 700; color: #33232c; }
.cancel-option {
    display: flex; align-items: center; gap: 12px; padding: 14px 4px;
    border-bottom: 1px solid #f0dce5; cursor: pointer; color: #33232c;
}
.cancel-option input { width: 19px; height: 19px; flex: 0 0 auto; accent-color: #e91e63; }
.cancel-details-label { display: block; margin: 20px 0 8px; font-weight: 700; }
.cancel-details-label span { font-weight: 400; color: #887681; }
#cancelDetails {
    width: 100%; box-sizing: border-box; resize: vertical; padding: 12px;
    border: 1px solid #e7cbd8; border-radius: 12px; font: inherit;
}
.cancel-modal__actions { display: flex; justify-content: flex-end; gap: 12px; margin-top: 22px; }
.cancel-button {
    min-width: 130px; padding: 13px 18px; border-radius: 30px;
    font-weight: 700; cursor: pointer;
}
.cancel-button--outline { border: 1px solid #e91e63; background: white; color: #e91e63; }
.cancel-button--primary { border: 0; background: #e91e63; color: white; }
.cancel-button--primary:disabled { background: #d9d6d8; color: #999; cursor: not-allowed; }
@media (max-width: 480px) {
    .cancel-modal__panel { padding: 24px 18px; }
    .cancel-modal__actions { flex-direction: column-reverse; }
    .cancel-button { width: 100%; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('cancelModal');
    const form = document.getElementById('cancelOrderForm');
    const submitButton = document.getElementById('submitCancel');

    window.openCancelForm = function (orderId) {
        document.getElementById('cancelOrderId').value = orderId;
        modal.setAttribute('aria-hidden', 'false');
    };

    function closeCancelForm() {
        modal.setAttribute('aria-hidden', 'true');
    }

    modal.querySelectorAll('[data-close-cancel]').forEach(button => {
        button.addEventListener('click', closeCancelForm);
    });

    form.addEventListener('change', () => {
        submitButton.disabled = !form.querySelector('input[name="reason"]:checked');
    });

    form.addEventListener('submit', event => {
        event.preventDefault();
        const selectedReason = form.querySelector('input[name="reason"]:checked');
        if (!selectedReason) return;

        alert(
            'Cancellation form submitted for order #' +
            document.getElementById('cancelOrderId').value +
            '\nReason: ' + selectedReason.value +
            (document.getElementById('cancelDetails').value
                ? '\nDetails: ' + document.getElementById('cancelDetails').value
                : '')
        );

        closeCancelForm();
    });
});
</script>

