<script>
document.addEventListener('DOMContentLoaded', function () {
    const cartKey = 'shineSmileCart';
    const countBadge = document.getElementById('headerCartCount');

    function readCart() {
        try {
            const value = JSON.parse(localStorage.getItem(cartKey) || '[]');
            return Array.isArray(value) ? value : [];
        } catch (error) {
            return [];
        }
    }

    function updateCount() {
        if (!countBadge) return;
        const cart = readCart();
        const count = cart.reduce(function (total, item) {
            return total + Math.max(0, Number(item.quantity) || 0);
        }, 0);
        countBadge.textContent = count;
    }

    document.addEventListener('click', function (event) {
        const button = event.target.closest(
            'button.add-button[data-product-id]'
        );

        if (!button || button.disabled) return;

        const id = Number(button.dataset.productId);
        const name = button.dataset.productName;
        const price = Number(button.dataset.productPrice);
        const stock = Number(button.dataset.productStock);

        if (!Number.isInteger(id) || id <= 0 ||
            !name || !Number.isFinite(price) || price < 0 ||
            !Number.isInteger(stock) || stock <= 0) {
            alert('This product is currently unavailable.');
            return;
        }

        const cart = readCart();
        const existing = cart.find(function (item) {
            return Number(item.id) === id;
        });

        if (existing) {
            const quantity = Number(existing.quantity) || 0;

            if (quantity >= stock) {
                alert('You have reached the available stock for this product.');
                return;
            }

            existing.quantity = quantity + 1;
            existing.stock = stock;
            existing.name = name;
            existing.price = price;
        } else {
            cart.push({
                id: id,
                name: name,
                price: price,
                quantity: 1,
                stock: stock
            });
        }

        try {
            localStorage.setItem(cartKey, JSON.stringify(cart));
        } catch (error) {
            alert('Unable to save your cart. Please check your browser storage.');
            return;
        }

        updateCount();

        if (button.dataset.buyNow === 'true') {
            window.location.href = '/customer/checkout';
            return;
        }

        const originalText = button.innerHTML;
        button.textContent = '✓ Added to Cart';
        setTimeout(function () {
            button.innerHTML = originalText;
        }, 1200);
    });

    updateCount();
});
</script>

