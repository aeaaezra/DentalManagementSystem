<script>
document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.getElementById('pcNotificationToggle');
    const dropdown = document.getElementById('pcNotificationDropdown');
    const closeButton = document.getElementById('pcNotificationClose');
    const markAllReadButton = document.getElementById('pcMarkAllRead');
    const list = document.getElementById('pcNotificationList');
    const count = document.getElementById('pcNotificationCount');

    if (!toggle || !dropdown || !list || !count) return;

    function closeDropdown() {
        dropdown.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
    }

    function addTextElement(parent, tag, className, value) {
        const element = document.createElement(tag);
        if (className) element.className = className;
        element.textContent = value || '';
        parent.appendChild(element);
        return element;
    }

    function renderNotifications(items, unreadCount) {
        count.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
        count.hidden = !unreadCount;
        list.replaceChildren();

        if (!items.length) {
            addTextElement(list, 'p', 'pc-notification-empty', 'You have no notifications.');
            return;
        }

        items.forEach(function (item) {
            const card = document.createElement('article');
            card.className = 'pc-notification-item' + (item.read ? '' : ' is-unread');
            addTextElement(card, 'strong', '', item.title || 'Notification');
            addTextElement(card, 'p', '', item.message || '');

            if (item.created_at) {
                addTextElement(card, 'time', '', item.created_at);
            }
            list.appendChild(card);
        });
    }

    async function loadNotifications() {
        list.replaceChildren();
        addTextElement(list, 'p', 'pc-notification-empty', 'Loading notifications…');

        try {
            const response = await fetch(@json(route('notifications.data')), {
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            });

            if (!response.ok) throw new Error('Notification request failed');
            const data = await response.json();

            if (!data.success) throw new Error('Notification response was unsuccessful');
            renderNotifications(
                Array.isArray(data.notifications) ? data.notifications : [],
                Number(data.unread_count) || 0
            );
        } catch (error) {
            list.replaceChildren();
            addTextElement(list, 'p', 'pc-notification-empty', 'Could not load notifications. Please try again.');
        }
    }

    toggle.addEventListener('click', function () {
        const willOpen = dropdown.hidden;
        dropdown.hidden = !willOpen;
        toggle.setAttribute('aria-expanded', String(willOpen));
        if (willOpen) loadNotifications();
    });

    if (closeButton) closeButton.addEventListener('click', closeDropdown);

    if (markAllReadButton) {
        markAllReadButton.addEventListener('click', async function () {
            markAllReadButton.disabled = true;

            try {
                const response = await fetch(@json(route('notifications.readAll')), {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': @json(csrf_token())
                    },
                    credentials: 'same-origin'
                });

                if (!response.ok) throw new Error('Could not mark notifications as read');

                await loadNotifications();
            } catch (error) {
                alert('Could not mark notifications as read. Please try again.');
            } finally {
                markAllReadButton.disabled = false;
            }
        });
    }

    document.addEventListener('click', function (event) {
        if (!event.target.closest('#pcNotifications')) closeDropdown();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeDropdown();
    });
});
</script>

