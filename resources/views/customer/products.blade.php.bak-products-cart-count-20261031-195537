
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PinkCart | Dental & Health Products</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --pink: #ec3189;
            --pink-dark: #d91d73;
            --pink-light: #fff0f7;
            --pink-bg: #fff8fb;
            --text: #26202a;
            --muted: #817783;
            --border: #f0e4eb;
            --white: #fff;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--pink-bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        a { color: inherit; text-decoration: none; }

        .promo {
            background: linear-gradient(90deg, #ed2584, #fa579e);
            color: white;
            padding: 10px 5%;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 12px;
            font-weight: 600;
        }

        .header {
            background: white;
            padding: 18px 5%;
            display: flex;
            align-items: center;
            gap: 30px;
            border-bottom: 1px solid var(--border);
        }

        .brand {
            min-width: 215px;
            font-size: 27px;
            font-weight: 800;
            color: var(--pink);
            letter-spacing: -1px;
        }

        .brand small {
            display: block;
            color: var(--muted);
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 0;
        }

        .search {
            display: flex;
            flex: 1;
            height: 46px;
            border: 2px solid var(--pink);
            border-radius: 9px;
            overflow: hidden;
            background: white;
        }

        .search input {
            flex: 1;
            min-width: 0;
            border: 0;
            padding: 0 16px;
            font-size: 13px;
            outline: none;
        }

        .search button {
            background: var(--pink);
            color: white;
            border: 0;
            width: 58px;
            cursor: pointer;
            font-size: 20px;
        }


        .pc-account { position: relative; }
        .pc-account-toggle {
            display: flex; align-items: center; gap: 10px;
            cursor: pointer; border: 0; background: transparent;
            font: inherit;
        }
        .pc-account-menu {
            position: absolute; z-index: 1000; top: calc(100% + 10px);
            right: 0; width: 245px; padding: 8px 0;
            background: #1e293b; color: #fff;
            border: 1px solid #475569; border-radius: 12px;
            box-shadow: 0 12px 32px #0003;
        }
        .pc-account-menu[hidden], .pc-logout-overlay[hidden] { display: none !important; }
        .pc-account-info { padding: 12px 16px; border-bottom: 1px solid #475569; }
        .pc-account-info strong, .pc-account-info small { display: block; overflow-wrap: anywhere; }
        .pc-account-info small { margin-top: 4px; color: #cbd5e1; font-size: 12px; }
        .pc-account-menu > a, .pc-logout-link {
            display: block; width: 100%; padding: 12px 16px;
            color: #fff; text-align: left; text-decoration: none;
            background: transparent; border: 0; font: inherit; cursor: pointer;
        }
        .pc-account-menu > a:hover { background: #334155; }
        .pc-logout-link { color: #fb7185; border-top: 1px solid #475569; }
        .pc-logout-overlay {
            position: fixed; inset: 0; z-index: 9999;
            display: flex; align-items: center; justify-content: center;
            padding: 20px; background: #0008;
        }
        .pc-logout-dialog {
            width: 100%; max-width: 420px; padding: 24px;
            background: #fff; color: #1f2937; border-radius: 16px;
            box-shadow: 0 20px 60px #0004;
        }
        .pc-logout-dialog h2 { margin: 0 0 10px; font-size: 20px; }
        .pc-logout-dialog p { margin: 0 0 22px; color: #64748b; }
        .pc-logout-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .pc-logout-actions button {
            padding: 10px 14px; border-radius: 9px; cursor: pointer;
            border: 1px solid #cbd5e1; background: #fff;
        }
        .pc-logout-actions form button {
            color: #fff; background: #e11d48; border-color: #e11d48;
        }
        @media (max-width: 600px) {
            .pc-account-menu { right: 0; width: min(245px, 85vw); }
            .pc-logout-actions { flex-wrap: wrap; }
        }

        .header-link {
            color: var(--pink);
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .nav {
            display: flex;
            justify-content: center;
            gap: 32px;
            flex-wrap: wrap;
            padding: 15px 4%;
            background: white;
            border-bottom: 1px solid var(--border);
            font-size: 12px;
            font-weight: 600;
        }

        .nav a:hover { color: var(--pink); }

        .container {
            width: min(1440px, 94%);
            margin: 22px auto 50px;
        }

        .hero {
            display: grid;
            grid-template-columns: 1fr 0.85fr;
            align-items: center;
            min-height: 310px;
            overflow: hidden;
            border-radius: 22px;
            padding: 38px 5%;
            background: linear-gradient(115deg, #fff0f7, #ffc4df);
        }

        .eyebrow {
            color: var(--pink);
            font-size: 11px;
            letter-spacing: 2px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(35px, 4vw, 58px);
            line-height: 1.04;
            letter-spacing: -2px;
            margin: 18px 0 12px;
        }

        .hero h1 span { color: var(--pink); }

        .hero p {
            max-width: 460px;
            line-height: 1.8;
            color: #756674;
            font-size: 14px;
        }

        .btn {
            display: inline-block;
            background: var(--pink);
            color: white;
            padding: 14px 25px;
            border-radius: 10px;
            border: 0;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            transition: .2s;
        }

        .btn:hover {
            background: var(--pink-dark);
            transform: translateY(-2px);
        }

        .hero-image {
            width: 100%;
            max-height: 275px;
            object-fit: contain;
            mix-blend-mode: multiply;
        }

        .benefits {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin: 16px 0 28px;
        }

        .benefit {
            padding: 19px;
            border: 1px solid var(--border);
            background: white;
            border-radius: 13px;
        }

        .benefit strong {
            display: block;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .benefit span {
            color: var(--muted);
            font-size: 11px;
        }

        .section { margin: 28px 0; }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .section-heading h2 {
            font-size: 22px;
            margin: 0;
            letter-spacing: -.6px;
        }

        .section-heading a {
            color: var(--pink);
            font-size: 12px;
            font-weight: 700;
        }

        .categories {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
        }

        .category {
            background: white;
            padding: 12px 8px;
            text-align: center;
            border: 1px solid var(--border);
            border-radius: 14px;
            transition: .2s;
        }

        .category:hover {
            border-color: var(--pink);
            transform: translateY(-3px);
        }

        .category img {
            display: block;
            width: 100%;
            height: 100px;
            object-fit: contain;
            margin: 4px auto 8px;
            border-radius: 8px;
        }

        .category strong {
            display: block;
            font-size: 12px;
            margin-top: 8px;
        }

        .category span {
            display: block;
            color: var(--pink);
            font-size: 11px;
            margin-top: 6px;
        }

        .deals {
            background: linear-gradient(120deg, #ffe8f3, #fff4f9);
            border-radius: 18px;
            padding: 22px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 12px;
        }

        .product {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 12px;
            min-width: 0;
            transition: .2s;
        }

        .product:hover {
            box-shadow: 0 8px 24px #d9287914;
            transform: translateY(-3px);
        }

        .product img {
            width: 100%;
            height: 150px;
            object-fit: contain;
            border-radius: 8px;
            background: #fffafd;
        }

        .product h3 {
            font-size: 12px;
            line-height: 1.5;
            min-height: 36px;
            margin: 10px 0;
        }

        .price {
            color: var(--pink);
            font-size: 18px;
            font-weight: 800;
        }

        .old-price {
            color: #999;
            font-size: 11px;
            text-decoration: line-through;
            margin-left: 6px;
        }

        .rating {
            color: #f3a51c;
            font-size: 12px;
            margin: 8px 0;
        }

        .rating span {
            color: var(--muted);
            font-size: 10px;
        }

        .product .btn {
            width: 100%;
            padding: 11px 5px;
            margin-top: 5px;
        }

        .product-action-buttons {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

        .product-action-buttons .btn {
            width: 100%;
            min-width: 0;
            margin-top: 0;
            padding: 11px 5px;
            font-size: 12px;
        }

        .product-action-buttons .buy-now {
            background: #fff;
            color: var(--pink);
            border: 1px solid var(--pink);
        }

        .product-action-buttons .buy-now:hover {
            background: var(--pink);
            color: #fff;
        }

        .product-action-buttons .btn:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none;
        }

        @media (max-width: 420px) {
            .product-action-buttons {
                grid-template-columns: 1fr;
            }
        }

        .footer {
            padding: 35px 5%;
            text-align: center;
            color: var(--muted);
            background: white;
            border-top: 1px solid var(--border);
            font-size: 12px;
        }

        @media (max-width: 1000px) {
            .header { flex-wrap: wrap; gap: 15px; }
            .brand { min-width: 150px; }
            .search { order: 3; flex-basis: 100%; }
            .categories { grid-template-columns: repeat(3, 1fr); }
            .products { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .hero { grid-template-columns: 1fr 0.7fr; }
            .benefits { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 600px) {
            .promo { justify-content: center; text-align: center; }
            .header { padding: 15px 4%; }
            .brand { font-size: 23px; }
            .nav { gap: 18px; justify-content: flex-start; }
            .container { width: 94%; margin-top: 14px; }
            .hero { grid-template-columns: 1fr; padding: 28px 23px; }
            .hero h1 { font-size: 38px; }
            .hero-image { max-height: 180px; margin-top: 15px; }
            .benefits { grid-template-columns: repeat(2, 1fr); }
            .benefit { padding: 12px; }
            .categories { grid-template-columns: repeat(2, 1fr); }
            .products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .product img { height: 120px; }
            .deals { padding: 12px; }
            .section-heading h2 { font-size: 18px; }
        }

        /* ===== BURGUNDY / BLACK / PINK STOREFRONT THEME ===== */
        body {
            background: #4a0028;
            color: #fff5fa;
        }

        .promo {
            background: #e90074;
            color: #ffffff;
        }

        .header {
            background: #171017;
            color: #ffffff;
            border-bottom: 1px solid #5b2041;
        }

        .brand,
        .nav a,
        .header-link {
            color: #ffffff;
        }

        .brand small {
            color: #f3bfd9;
        }

        .search input {
            background: #ffffff;
            color: #27101d;
            border-color: #f3bfd9;
        }

        .container {
            color: #fff5fa;
        }

        .hero {
            background: linear-gradient(115deg, #fff8fc, #f9d7e8);
            color: #3b1029;
        }

        .hero h1,
        .hero p {
            color: #3b1029;
        }

        .section-heading h2 {
            color: #fff5fa;
        }

        .section-heading a {
            color: #ff1688;
        }

        .categories .category {
            display: block;
            overflow: hidden;
            padding: 0 0 14px;
            background: #ffffff !important;
            color: #27101d !important;
            border: 1px solid #f3c4dc;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .16);
            text-decoration: none;
        }

        .categories .category img {
            display: block;
            width: 100%;
            height: 145px;
            margin: 0 0 12px;
            padding: 0;
            object-fit: cover;
            border-radius: 0;
            background: #ffffff;
        }

        .categories .category strong {
            display: block;
            padding: 0 10px;
            color: #a50055;
            font-size: 13px;
            font-weight: 800;
        }

        .categories .category span {
            padding: 0 10px;
            color: #e90074;
        }

        .categories .category:hover {
            transform: translateY(-3px);
            border-color: #ff1688;
            box-shadow: 0 12px 25px rgba(0, 0, 0, .24);
        }

        .deals {
            background: #35001f;
            border: 1px solid #642344;
        }

        .product {
            background: #ffffff;
            color: #27101d;
            border-color: #f3c4dc;
        }

        .product h3,
        .product strong,
        .product p {
            color: #27101d;
        }

        .product button,
        .product .btn {
            background: #e90074;
            color: #ffffff;
        }

        @media (max-width: 600px) {
            .categories .category img {
                height: 115px;
            }
        }


        /* =====================================================
           PINKCART PREMIUM PINK & WHITE REDESIGN
           ===================================================== */

        :root {
            --pc-pink: #e91e63;
            --pc-pink-dark: #c2185b;
            --pc-pink-light: #fff0f6;
            --pc-pink-border: #f5d5e2;
            --pc-plum: #492238;
            --pc-muted: #806b78;
            --pc-white: #ffffff;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #fff8fb !important;
            color: var(--pc-plum) !important;
        }

        a {
            transition: color .2s ease, background .2s ease,
                        border-color .2s ease, box-shadow .2s ease,
                        transform .2s ease;
        }

        /* Promotional strip */
        .promo {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px 35px;
            padding: 11px 18px;
            background: linear-gradient(90deg, #c2185b, #ed3e83, #d81b60) !important;
            color: #ffffff !important;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .15px;
        }

        /* White navigation and brand header */
        .header {
            position: relative;
            display: flex;
            align-items: center;
            gap: 28px;
            padding: 20px clamp(18px, 4vw, 65px);
            background: #ffffff !important;
            color: var(--pc-plum) !important;
            border-bottom: 1px solid var(--pc-pink-border) !important;
            box-shadow: 0 5px 22px rgba(102, 28, 64, .045);
        }

        .brand {
            flex-shrink: 0;
            color: var(--pc-pink-dark) !important;
            font-size: 27px;
            font-weight: 850;
            letter-spacing: -.8px;
            text-decoration: none;
        }

        .brand small {
            display: block;
            margin-top: 4px;
            color: var(--pc-muted) !important;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .3px;
        }

        .nav a,
        .header-link {
            color: var(--pc-plum) !important;
            font-weight: 650;
        }

        .nav a:hover,
        .header-link:hover {
            color: var(--pc-pink) !important;
        }

        /* Search bar */
        .search {
            display: flex;
            flex: 1;
            min-width: 150px;
            max-width: 680px;
            height: 47px;
            overflow: hidden;
            border: 1px solid #edb8ce;
            border-radius: 12px;
            background: #fff8fb;
            box-shadow: 0 3px 10px rgba(150, 36, 85, .035);
        }

        .search:focus-within {
            border-color: var(--pc-pink);
            box-shadow: 0 0 0 3px rgba(233, 30, 99, .10);
        }

        .search input {
            flex: 1;
            width: 100%;
            min-width: 0;
            padding: 0 16px;
            border: 0 !important;
            outline: none;
            background: transparent !important;
            color: var(--pc-plum) !important;
            font-size: 12px;
        }

        .search input::placeholder {
            color: #aa929e;
        }

        .search button {
            min-width: 52px;
            padding: 0 17px;
            border: 0;
            background: var(--pc-pink) !important;
            color: #ffffff !important;
            font-size: 23px;
            cursor: pointer;
        }

        .search button:hover {
            background: var(--pc-pink-dark) !important;
        }

        /* Main content width and spacing */
        .container {
            width: min(1400px, 92%);
            margin-right: auto;
            margin-left: auto;
            color: var(--pc-plum) !important;
        }

        /* Large pink-and-white hero */
        .hero {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            margin: 28px 0 38px;
            padding: clamp(30px, 5vw, 65px);
            border: 1px solid #f4d2e0;
            border-radius: 25px;
            background:
                radial-gradient(ellipse at 88% 12%, rgba(255, 255, 255, .95), transparent 38%),
                linear-gradient(115deg, #ffffff 0%, #fff2f7 48%, #fbd8e8 100%) !important;
            color: var(--pc-plum) !important;
            box-shadow: 0 13px 35px rgba(143, 39, 83, .075);
        }

        .hero::after {
            position: absolute;
            z-index: -1;
            right: -65px;
            bottom: -115px;
            width: 300px;
            height: 300px;
            border: 35px solid rgba(233, 30, 99, .055);
            border-radius: 50%;
            content: "";
            pointer-events: none;
        }

        .hero h1 {
            max-width: 680px;
            color: var(--pc-plum) !important;
            font-size: clamp(34px, 4.5vw, 57px);
            font-weight: 850;
            line-height: 1.12;
            letter-spacing: -1.7px;
        }

        .hero h1 span {
            color: var(--pc-pink) !important;
        }

        .hero p {
            max-width: 540px;
            margin-top: 16px;
            color: #786371 !important;
            font-size: 14px;
            line-height: 1.85;
        }

        .hero-image {
            max-width: 100%;
            height: auto;
            object-fit: contain;
            filter: drop-shadow(0 12px 18px rgba(123, 40, 78, .10));
        }

        /* Section headings */
        .section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin: 34px 0 19px;
        }

        .section-heading h2 {
            color: var(--pc-plum) !important;
            font-size: clamp(21px, 2.5vw, 28px);
            font-weight: 850;
            letter-spacing: -.5px;
        }

        .section-heading a {
            color: var(--pc-pink) !important;
            font-size: 12px;
            font-weight: 750;
            text-decoration: none;
        }

        .section-heading a:hover {
            color: var(--pc-pink-dark) !important;
        }

        /* Category cards */
        .categories {
            gap: 18px;
        }

        .categories .category {
            display: block;
            overflow: hidden;
            padding: 0 0 17px;
            border: 1px solid var(--pc-pink-border) !important;
            border-radius: 17px;
            background: #ffffff !important;
            color: var(--pc-plum) !important;
            box-shadow: 0 9px 24px rgba(104, 34, 67, .13);
            text-decoration: none;
        }

        .categories .category img {
            display: block;
            width: 100%;
            height: 155px;
            margin: 0 0 14px;
            padding: 12px;
            object-fit: contain;
            background: linear-gradient(145deg, #fffafd, #fff0f6);
            transition: transform .3s ease;
        }

        .categories .category strong {
            display: block;
            padding: 0 13px;
            color: var(--pc-plum) !important;
            font-size: 13px;
            font-weight: 800;
            line-height: 1.5;
        }

        .categories .category span {
            display: block;
            padding: 5px 13px 0;
            color: var(--pc-pink) !important;
            font-size: 11px;
        }

        .categories .category:hover {
            transform: translateY(-5px);
            border-color: #ed8db4 !important;
            box-shadow: 0 18px 34px rgba(180, 41, 99, .22);
        }

        .categories .category:hover img {
            transform: scale(1.045);
        }

        /* Featured deals */
        .deals {
            overflow: hidden;
            border: 1px solid var(--pc-pink-border) !important;
            border-radius: 19px;
            background: linear-gradient(125deg, #fff0f6, #ffffff) !important;
            color: var(--pc-plum) !important;
            box-shadow: 0 7px 22px rgba(104, 34, 67, .04);
        }

        /* Product cards */
        .product {
            overflow: hidden;
            border: 1px solid var(--pc-pink-border) !important;
            border-radius: 16px;
            background: #ffffff !important;
            color: var(--pc-plum) !important;
            box-shadow: 0 5px 17px rgba(104, 34, 67, .045);
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .product:hover {
            transform: translateY(-4px);
            box-shadow: 0 13px 28px rgba(180, 41, 99, .10);
        }

        .product h3,
        .product strong {
            color: var(--pc-plum) !important;
        }

        .product p {
            color: #826d79 !important;
        }

        .product button,
        .product .btn {
            border: 0;
            border-radius: 9px;
            background: var(--pc-pink) !important;
            color: #ffffff !important;
            font-weight: 750;
            transition: background .2s ease, transform .2s ease;
        }

        .product button:hover,
        .product .btn:hover {
            background: var(--pc-pink-dark) !important;
            transform: translateY(-1px);
        }

        /* Keyboard accessibility */
        a:focus-visible,
        button:focus-visible,
        input:focus-visible {
            outline: 3px solid rgba(233, 30, 99, .45);
