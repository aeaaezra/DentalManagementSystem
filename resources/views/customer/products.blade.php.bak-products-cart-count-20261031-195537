   <script>
(function () {
    const button = document.getElementById('see-more-products');
    const grid = document.getElementById('product-grid');
    const status = document.getElementById('see-more-status');

    if (!button || !grid) return;

    button.addEventListener('click', async function () {
        if (button.disabled) return;

        const nextPage = Number(button.dataset.nextPage);
        const lastPage = Number(button.dataset.lastPage);

        button.disabled = true;
        button.textContent = 'Loading...';
        if (status) status.textContent = 'Loading more products...';

        try {
            const url = new URL(window.location.href);
            url.searchParams.set('page', String(nextPage));

            const response = await fetch(url.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) {
                throw new Error('Could not load products.');
            }

            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const incomingGrid = doc.querySelector('#product-grid');

            if (!incomingGrid) {
                throw new Error('Product list was not found in the response.');
            }

            const cards = Array.from(incomingGrid.children).filter(function (item) {
                return item.matches('article.product');
            });

            if (cards.length === 0) {
                button.remove();
                if (status) status.textContent = 'You have reached the end of the products.';
                return;
            }

            cards.forEach(function (card) {
                grid.appendChild(document.importNode(card, true));
            });

            const loadedPage = nextPage;
            const incomingButton = doc.querySelector('#see-more-products');

            if (incomingButton) {
                button.dataset.nextPage = incomingButton.dataset.nextPage;
                button.dataset.lastPage = incomingButton.dataset.lastPage;
            }

            if (!incomingButton || loadedPage >= lastPage) {
                button.remove();
                if (status) status.textContent = 'You have viewed all available products.';
            } else {
                button.disabled = false;
                button.textContent = 'See More';
                if (status) status.textContent = '';
            }
        } catch (error) {
            button.disabled = false;
            button.textContent = 'Try Again';
            if (status) status.textContent = 'Unable to load more products. Please try again.';
            console.error(error);
        }
    });
})();
</script>

   <script>
document.addEventListener('click', function (event) {
    const choice = event.target.closest('.shop-variant-choice');
    if (!choice) return;

    const picker = choice.closest('.shop-variant-picker');
    if (!picker) return;

    const card = choice.closest('.product');
    if (!card) return;

    const selector = card.querySelector('.variant-selector');
    const status = picker.querySelector('.shop-variant-status');
    const colorButtons = picker.querySelectorAll('.shop-color-choice');
    const sizeButtons = picker.querySelectorAll('.shop-size-choice');

    if (choice.classList.contains('shop-color-choice')) {
        colorButtons.forEach(button => {
            const active = button === choice;
            button.dataset.selected = active ? 'true' : 'false';
            button.style.background = active ? '#df267c' : '#fff';
            button.style.color = active ? '#fff' : '#333';
            button.style.borderColor = active ? '#df267c' : '#e5a8c8';
        });
    } else {
        sizeButtons.forEach(button => {
            const active = button === choice;
            button.dataset.selected = active ? 'true' : 'false';
            button.style.background = active ? '#df267c' : '#fff';
            button.style.color = active ? '#fff' : '#333';
            button.style.borderColor = active ? '#df267c' : '#ddd';
        });
    }

    const selectedColor = picker.querySelector('.shop-color-choice[data-selected="true"]');
    const selectedSize = picker.querySelector('.shop-size-choice[data-selected="true"]');

    if (selector) selector.value = '';

    if (!selectedColor || !selectedSize) {
        if (status) status.textContent = 'Choose a color and size';
        return;
    }

    const color = selectedColor.dataset.colorChoice.trim().toLowerCase();
    const size = selectedSize.dataset.sizeChoice.trim().toLowerCase();

    const matchingOption = Array.from(selector.options).find(option =>
        option.value &&
        String(option.dataset.color || '').trim().toLowerCase() === color &&
        String(option.dataset.name || '').trim().toLowerCase() === size
    );

    if (!matchingOption) {
        if (status) status.textContent = 'This color and size combination is unavailable';
        return;
    }

    if (Number(matchingOption.dataset.stock) <= 0 || matchingOption.disabled) {
        if (status) status.textContent = 'Out of stock for this combination';
        return;
    }

    selector.value = matchingOption.value;

    const priceDisplay = card.querySelector('.price');
    if (priceDisplay) {
        priceDisplay.textContent = '₱' + Number(matchingOption.dataset.price).toLocaleString(
            'en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }
        );
    }

    if (status) {
        status.textContent = 'Stock: ' + matchingOption.dataset.stock +
            ' · Price: ₱' + Number(matchingOption.dataset.price).toFixed(2);
    }
});

document.addEventListener('click', function (event) {
    const button = event.target.closest('.add-to-cart, .buy-now');
    if (!button || button.disabled) return;

    const card = button.closest('.product');

    // Front-page Buy Now opens the product details page first.
    if (button.classList.contains('buy-now')) {
        const productLink = card
            ? card.querySelector('a[href*="/customer/products/"]')
            : null;

        if (productLink) {
            window.location.href = productLink.href;
            return;
        }

        alert('Product details page link was not found.');
        return;
    }

    const selector = card ? card.querySelector('.variant-selector') : null;
    const selected = selector ? selector.options[selector.selectedIndex] : null;

    const id = Number(button.dataset.id);
    const variantId = selected ? Number(selected.value) : null;
    const stock = selected ? Number(selected.dataset.stock) : Number(button.dataset.stock);
    const price = selected ? Number(selected.dataset.price) : Number(button.dataset.price);
    const productName = button.dataset.name || 'Product';
    const productImage = button.dataset.image || '';
    const variantName = selected ? (selected.dataset.name || selected.textContent.trim()) : '';
    const cartKey = String(id) + ':' + String(variantId || 0);

    if (!Number.isInteger(id) || id <= 0 ||
        (button.dataset.variantRequired === 'true' &&
            (!selected || !Number.isInteger(variantId) || variantId <= 0)) ||
        !Number.isFinite(price) || price < 0 ||
        !Number.isInteger(stock) || stock <= 0) {
        alert('This variant is currently unavailable. Please choose an in-stock option.');
        return;
    }

    let cart;
    try {
        cart = JSON.parse(localStorage.getItem('shineSmileCart') || '[]');
        if (!Array.isArray(cart)) cart = [];
    } catch (error) {
        cart = [];
    }

    const existing = cart.find(function (item) {
        const key = item.cart_key || (String(item.id) + ':' + String(item.variant_id || 0));
        return key === cartKey;
    });

    if (existing) {
        const quantity = Number(existing.quantity);
        if (!Number.isInteger(quantity) || quantity < 1 || quantity >= stock) {
            alert('You have reached the available stock for this variant.');
            return;
        }
        existing.quantity = quantity + 1;
        existing.stock = stock;
        existing.name = productName;
        existing.image = productImage || existing.image || '';
        existing.variant_id = variantId;
        existing.variant_name = variantName;
        existing.cart_key = cartKey;
        existing.price = price;
    } else {
        cart.push({
            id: id,
            name: productName,
            image: productImage,
            variant_id: variantId,
            variant_name: variantName,
            cart_key: cartKey,
            price: price,
            quantity: 1,
            stock: stock
        });
    }

    try {
        localStorage.setItem('shineSmileCart', JSON.stringify(cart));
    } catch (error) {
        alert('Unable to save your cart. Please check your browser storage settings.');
        return;
    }

    if (button.dataset.buyNow === 'true') {
        window.location.href = @json(url('/customer/checkout'));
        return;
    }

    const originalText = button.textContent;
    button.textContent = '✓ Added to Cart';
    setTimeout(() => { button.textContent = originalText; }, 1200);

    const cartToast = document.getElementById('productCartToast');
    if (cartToast) {
        const toastMessage = document.getElementById('productCartToastMessage');
        if (toastMessage) {
            toastMessage.textContent = productName + ' added to cart!';
        }

        cartToast.style.display = 'flex';
        cartToast.classList.add('show');
        cartToast.style.opacity = '1';
        cartToast.style.visibility = 'visible';
        cartToast.style.transform = 'translateY(0)';

        clearTimeout(window.productCartToastTimer);
        window.productCartToastTimer = setTimeout(function () {
            cartToast.classList.remove('show');
            cartToast.style.opacity = '';
            cartToast.style.visibility = '';
            cartToast.style.transform = '';
        }, 3500);
    }
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.getElementById('pcAccountToggle');
    const menu = document.getElementById('pcAccountMenu');
    const modal = document.getElementById('pcLogoutModal');
    const openLogout = document.getElementById('pcOpenLogout');
    const cancelLogout = document.getElementById('pcCancelLogout');

    if (!toggle || !menu) return;

    function closeMenu() {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
    }

    toggle.addEventListener('click', function (event) {
        event.stopPropagation();
        menu.hidden = !menu.hidden;
        toggle.setAttribute('aria-expanded', String(!menu.hidden));
    });

    document.addEventListener('click', function (event) {
        if (!event.target.closest('#pcAccount')) closeMenu();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeMenu();
            if (modal && !modal.hidden) {
                modal.hidden = true;
                toggle.focus();
            }
        }
    });

    if (openLogout && modal) {
        openLogout.addEventListener('click', function () {
            closeMenu();
            modal.hidden = false;
            if (cancelLogout) cancelLogout.focus();
        });
    }

    if (cancelLogout && modal) {
        cancelLogout.addEventListener('click', function () {
            modal.hidden = true;
            toggle.focus();
        });
    }

    if (modal) {
        modal.addEventListener('click', function (event) {
            if (event.target === modal) modal.hidden = true;
        });
    }
});
</script>

