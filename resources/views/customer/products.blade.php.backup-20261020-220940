            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 12px;
            font-weight: 600;
        }

        .header {
            background: white;
            padding: 18px 5%;
            display: flex;
            align-items: center;
            gap: 30px;
            border-bottom: 1px solid var(--border);
        }

        .brand {
            min-width: 215px;
            font-size: 27px;
            font-weight: 800;
            color: var(--pink);
            letter-spacing: -1px;
        }

        .brand small {
            display: block;
            color: var(--muted);
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 0;
        }

        .search {
            display: flex;
            flex: 1;
            height: 46px;
            border: 2px solid var(--pink);
            border-radius: 9px;
            overflow: hidden;
            background: white;
        }

        .search input {
            flex: 1;
            min-width: 0;
            border: 0;
            padding: 0 16px;
            font-size: 13px;
            outline: none;
        }

        .search button {
            background: var(--pink);
            color: white;
            border: 0;
            width: 58px;
            cursor: pointer;
            font-size: 20px;
        }

        .header-link {
            color: var(--pink);
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .nav {
            display: flex;
            justify-content: center;
