        .nav a:hover { color: var(--pink); }

        .container {
            width: min(1440px, 94%);
            margin: 22px auto 50px;
        }

        .hero {
            display: grid;
            grid-template-columns: 1fr 0.85fr;
            align-items: center;
            min-height: 310px;
            overflow: hidden;
            border-radius: 22px;
            padding: 38px 5%;
            background: linear-gradient(115deg, #fff0f7, #ffc4df);
