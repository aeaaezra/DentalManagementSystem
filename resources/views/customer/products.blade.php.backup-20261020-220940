            border-color: var(--pink);
            transform: translateY(-3px);
        }

        .category img {
            width: 100%;
            height: 90px;
            object-fit: contain;
        }

        .category strong {
            display: block;
            font-size: 12px;
            margin-top: 8px;
        }

        .category span {
            display: block;
            color: var(--pink);
            font-size: 11px;
            margin-top: 6px;
        }

        .deals {
            background: linear-gradient(120deg, #ffe8f3, #fff4f9);
            border-radius: 18px;
            padding: 22px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 12px;
        }

        .product {
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 12px;
            min-width: 0;
            transition: .2s;
        }

        .product:hover {
            box-shadow: 0 8px 24px #d9287914;
            transform: translateY(-3px);
        }

        .product img {
            width: 100%;
            height: 150px;
            object-fit: contain;
            border-radius: 8px;
            background: #fffafd;
        }

        .product h3 {
            font-size: 12px;
            line-height: 1.5;
            min-height: 36px;
            margin: 10px 0;
        }

        .price {
            color: var(--pink);
            font-size: 18px;
            font-weight: 800;
        }

        .old-price {
            color: #999;
            font-size: 11px;
            text-decoration: line-through;
            margin-left: 6px;
        }

        .rating {
            color: #f3a51c;
            font-size: 12px;
            margin: 8px 0;
        }

        .rating span {
