        .product .btn {
            width: 100%;
            padding: 11px 5px;
            margin-top: 5px;
        }

        .footer {
            padding: 35px 5%;
            text-align: center;
            color: var(--muted);
            background: white;
            border-top: 1px solid var(--border);
            font-size: 12px;
        }

        @media (max-width: 1000px) {
            .header { flex-wrap: wrap; gap: 15px; }
            .brand { min-width: 150px; }
            .search { order: 3; flex-basis: 100%; }
            .categories { grid-template-columns: repeat(3, 1fr); }
            .products { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .hero { grid-template-columns: 1fr 0.7fr; }
            .benefits { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 600px) {
            .promo { justify-content: center; text-align: center; }
            .header { padding: 15px 4%; }
            .brand { font-size: 23px; }
            .nav { gap: 18px; justify-content: flex-start; }
            .container { width: 94%; margin-top: 14px; }
            .hero { grid-template-columns: 1fr; padding: 28px 23px; }
            .hero h1 { font-size: 38px; }
            .hero-image { max-height: 180px; margin-top: 15px; }
            .benefits { grid-template-columns: repeat(2, 1fr); }
            .benefit { padding: 12px; }
            .categories { grid-template-columns: repeat(2, 1fr); }
            .products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .product img { height: 120px; }
            .deals { padding: 12px; }
            .section-heading h2 { font-size: 18px; }
        }
