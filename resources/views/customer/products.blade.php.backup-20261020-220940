    <style>
        :root {
            --pink: #ec3189;
            --pink-dark: #d91d73;
            --pink-light: #fff0f7;
            --pink-bg: #fff8fb;
            --text: #26202a;
            --muted: #817783;
            --border: #f0e4eb;
            --white: #fff;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--pink-bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        a { color: inherit; text-decoration: none; }

        .promo {
            background: linear-gradient(90deg, #ed2584, #fa579e);
            color: white;
            padding: 10px 5%;
