/* ============================================================
   DENTIST DASHBOARD
   Shine & Smile Dental Clinic
============================================================ */

:root {
    --primary: #db2777;
    --primary-dark: #be185d;
    --primary-light: #fce7f3;

    --blue: #3b82f6;
    --blue-light: #eff6ff;

    --green: #16a34a;
    --green-light: #f0fdf4;

    --orange: #f59e0b;
    --orange-light: #fffbeb;

    --purple: #8b5cf6;
    --purple-light: #f5f3ff;

    --red: #dc2626;
    --red-light: #fef2f2;

    --text: #1f2937;
    --text-light: #6b7280;
    --muted: #9ca3af;

    --border: #e5e7eb;
    --background: #f8fafc;
    --white: #ffffff;

    --sidebar-width: 260px;

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
    --shadow: 0 4px 15px rgba(0, 0, 0, 0.06);

    --radius: 14px;
}


/* ============================================================
   RESET
============================================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: var(--background);
    color: var(--text);

    min-height: 100vh;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}


/* ============================================================
   PAGE
============================================================ */

.dashboard-page {
    min-height: 100vh;
    width: 100%;
}


/* ============================================================
   SIDEBAR
============================================================ */

.sidebar {
    position: fixed;

    top: 0;
    left: 0;

    width: var(--sidebar-width);
    height: 100vh;

    background: var(--white);

    border-right: 1px solid var(--border);

    display: flex;
    flex-direction: column;

    z-index: 1000;

    transition: transform 0.25s ease;
}


.sidebar-header {
    height: 82px;

    padding: 18px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid var(--border);
}


.clinic-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}


.clinic-logo {
    width: 43px;
    height: 43px;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            #f472b6
        );

    color: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow:
        0 5px 12px rgba(219, 39, 119, 0.20);
}


.clinic-logo svg {
    width: 28px;
    height: 28px;
}


.clinic-brand-text {
    display: flex;
    flex-direction: column;
}


.clinic-brand-text strong {
    font-size: 15px;
    font-weight: 800;
}


.clinic-brand-text span {
    margin-top: 2px;

    font-size: 10px;

    color: var(--text-light);
}


.sidebar-close {
    display: none;

    width: 34px;
    height: 34px;

    border: 0;

    background: transparent;

    color: var(--text-light);

    align-items: center;
    justify-content: center;
}


.sidebar-close svg {
    width: 21px;
}


/* ============================================================
   SIDEBAR NAVIGATION
============================================================ */

.sidebar-navigation {
    flex: 1;

    padding: 20px 12px;

    overflow-y: auto;
}


.navigation-section-title {
    padding: 0 12px;

    margin: 8px 0 10px;

    font-size: 9px;

    letter-spacing: 0.09em;

    color: var(--muted);

    font-weight: 800;
}


.navigation-item {
    display: flex;
    align-items: center;

    gap: 12px;

    width: 100%;

    padding: 12px;

    margin-bottom: 4px;

    border-radius: 10px;

    color: var(--text-light);

    font-size: 13px;

    font-weight: 600;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}


.navigation-item:hover {
    background: var(--primary-light);
    color: var(--primary);
}


.navigation-item.active {
    background: var(--primary-light);
    color: var(--primary);
}


.navigation-icon {
    width: 20px;
    height: 20px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
}


.navigation-icon svg {
    width: 20px;
    height: 20px;
}


.navigation-divider {
    height: 1px;

    margin: 18px 8px;

    background: var(--border);
}


.sidebar-footer {
    padding: 14px;

    border-top: 1px solid var(--border);
}


.sidebar-footer form {
    width: 100%;
}


.logout-button {
    width: 100%;

    padding: 12px;

    border: 0;

    border-radius: 10px;

    background: transparent;

    color: var(--text-light);

    display: flex;
    align-items: center;

    gap: 12px;

    font-weight: 600;

    text-align: left;

    transition: 0.2s ease;
}


.logout-button:hover {
    background: var(--red-light);
    color: var(--red);
}


/* ============================================================
   MAIN CONTENT
============================================================ */

.main-content {
    width: calc(100% - var(--sidebar-width));

    min-height: 100vh;

    margin-left: var(--sidebar-width);
}


/* ============================================================
   HEADER
============================================================ */

.top-header {
    height: 82px;

    padding: 0 30px;

    background: var(--white);

    border-bottom: 1px solid var(--border);

    display: flex;
    align-items: center;
    justify-content: space-between;
}


.header-left {
    display: flex;
    align-items: center;

    gap: 15px;
}


.mobile-menu-button {
    display: none;

    width: 40px;
    height: 40px;

    border: 1px solid var(--border);

    border-radius: 10px;

    background: var(--white);

    color: var(--text-light);

    align-items: center;
    justify-content: center;
}


.mobile-menu-button svg {
    width: 21px;
}


.page-title {
    font-size: 22px;

    font-weight: 800;

    letter-spacing: -0.02em;
}


.page-subtitle {
    margin-top: 4px;

    color: var(--text-light);

    font-size: 12px;
}


.header-right {
    display: flex;
    align-items: center;

    gap: 17px;
}


.header-icon-button {
    position: relative;

    width: 40px;
    height: 40px;

    border: 1px solid var(--border);

    border-radius: 10px;

    background: var(--white);

    color: var(--text-light);

    display: flex;
    align-items: center;
    justify-content: center;

    transition: 0.2s ease;
}


.header-icon-button:hover {
    background: var(--primary-light);
    color: var(--primary);
}


.header-icon-button svg {
    width: 20px;
}


.notification-badge {
    position: absolute;

    top: -4px;
    right: -4px;

    min-width: 18px;
    height: 18px;

    padding: 0 4px;

    border-radius: 999px;

    background: var(--primary);

    color: #ffffff;

    font-size: 9px;

    font-weight: 800;

    display: flex;
    align-items: center;
    justify-content: center;
}


.header-profile {
    display: flex;
    align-items: center;

    gap: 9px;
}


.header-profile-avatar {
    width: 40px;
    height: 40px;

    border-radius: 50%;

    background: var(--primary-light);

    color: var(--primary);

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 14px;

    font-weight: 800;

    overflow: hidden;
}


.header-profile-avatar img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}


.header-profile-info {
    display: flex;
    flex-direction: column;
}


.header-profile-info strong {
    font-size: 12px;
}


.header-profile-info span {
    margin-top: 2px;

    color: var(--text-light);

    font-size: 10px;
}


/* ============================================================
   DASHBOARD BODY
============================================================ */

.dashboard-body {
    padding: 28px 30px 40px;
}


.dashboard-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
}


.breadcrumb {
    display: flex;
    align-items: center;

    gap: 5px;

    margin-bottom: 7px;

    color: var(--muted);

    font-size: 10px;
}


.breadcrumb svg {
    width: 13px;
}


.dashboard-intro h2 {
    font-size: 21px;

    font-weight: 800;

    letter-spacing: -0.02em;
}


.dashboard-intro p {
    margin-top: 4px;

    color: var(--text-light);

    font-size: 12px;
}


.dashboard-date {
    min-height: 38px;

    padding: 0 13px;

    border: 1px solid var(--border);

    border-radius: 9px;

    background: var(--white);

    color: var(--text-light);

    display: flex;
    align-items: center;

    gap: 8px;

    font-size: 11px;

    font-weight: 600;
}


.dashboard-date svg {
    width: 17px;
}


/* ============================================================
   STATISTICS
============================================================ */

.stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;

    margin-bottom: 20px;
}


.dashboard-stat-card {
    padding: 18px;

    background: var(--white);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    box-shadow: var(--shadow-sm);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


.dashboard-stat-card:hover {
    transform: translateY(-2px);

    box-shadow: var(--shadow);
}


.stat-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}


.stat-icon {
    width: 42px;
    height: 42px;

    border-radius: 11px;

    display: flex;
    align-items: center;
    justify-content: center;
}


.stat-icon svg {
    width: 21px;
}


.stat-icon.blue {
    background: var(--blue-light);
    color: var(--blue);
}


.stat-icon.orange {
    background: var(--orange-light);
    color: var(--orange);
}


.stat-icon.green {
    background: var(--green-light);
    color: var(--green);
}


.stat-icon.purple {
    background: var(--purple-light);
    color: var(--purple);
}


.stat-label {
    color: var(--muted);

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 0.08em;
}


.stat-number {
    display: block;

    margin-top: 15px;

    font-size: 27px;

    font-weight: 800;

    letter-spacing: -0.03em;
}


.stat-description {
    display: block;

    margin-top: 2px;

    color: var(--text-light);

    font-size: 10px;
}


/* ============================================================
   DASHBOARD GRID
============================================================ */

.dashboard-grid {
    display: grid;

    grid-template-columns:
        minmax(0, 1.7fr)
        minmax(280px, 0.8fr);

    gap: 20px;

    margin-bottom: 20px;
}


.dashboard-card {
    background: var(--white);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    overflow: hidden;

    box-shadow: var(--shadow-sm);
}


/* ============================================================
   CARD HEADER
============================================================ */

.card-header {
    min-height: 76px;

    padding: 18px 20px;

    border-bottom: 1px solid var(--border);

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;
}


.card-header h3 {
    font-size: 15px;

    font-weight: 800;
}


.card-header p {
    margin-top: 4px;

    color: var(--text-light);

    font-size: 10px;
}


.view-all-link {
    display: inline-flex;
    align-items: center;

    gap: 5px;

    color: var(--primary);

    font-size: 10px;

    font-weight: 800;

    white-space: nowrap;
}


.view-all-link svg {
    width: 15px;
}


.view-all-link:hover {
    color: var(--primary-dark);
}


/* ============================================================
   APPOINTMENT LIST
============================================================ */

.appointment-list {
    padding: 5px 20px 12px;
}


.dashboard-appointment {
    min-height: 70px;

    padding: 13px 0;

    display: grid;

    grid-template-columns:
        75px
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 15px;

    border-bottom: 1px solid #f1f5f9;
}


.dashboard-appointment:last-child {
    border-bottom: 0;
}


.appointment-time {
    display: flex;
    flex-direction: column;

    align-items: flex-start;
}


.appointment-time strong {
    font-size: 13px;
}


.appointment-time span {
    margin-top: 2px;

    color: var(--muted);

    font-size: 9px;
}


.appointment-patient {
    display: flex;
    align-items: center;

    gap: 10px;

    min-width: 0;
}


.patient-avatar {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--primary-light);

    color: var(--primary);

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 12px;

    font-weight: 800;
}


.appointment-patient > div:last-child {
    min-width: 0;

    display: flex;
    flex-direction: column;
}


.appointment-patient strong {
    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: 12px;
}


.appointment-patient span {
    margin-top: 3px;

    color: var(--text-light);

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: 9px;
}


/* ============================================================
   STATUS BADGES
============================================================ */

.appointment-status {
    padding: 5px 9px;

    border-radius: 999px;

    font-size: 9px;

    font-weight: 800;

    white-space: nowrap;
}


.status-pending {
    background: var(--orange-light);
    color: #b45309;
}


.status-approved,
.status-confirmed {
    background: var(--green-light);
    color: var(--green);
}


.status-completed {
    background: var(--blue-light);
    color: var(--blue);
}


.status-declined,
.status-cancelled {
    background: var(--red-light);
    color: var(--red);
}


/* ============================================================
   NEXT APPOINTMENT
============================================================ */

.next-card {
    min-height: 100%;
}


.next-appointment-box {
    margin: 20px;

    padding: 20px;

    border-radius: 13px;

    background:
        linear-gradient(
            145deg,
            #fce7f3,
            #fff1f2
        );

    text-align: center;
}


.next-appointment-time {
    display: flex;
    flex-direction: column;
}


.next-appointment-time span {
    color: var(--primary);

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.1em;
}


.next-appointment-time strong {
    margin-top: 3px;

    color: var(--primary-dark);

    font-size: 21px;
}


.next-patient-avatar {
    width: 54px;
    height: 54px;

    margin: 17px auto 10px;

    border-radius: 50%;

    background: var(--white);

    color: var(--primary);

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 18px;

    font-weight: 800;

    box-shadow: var(--shadow-sm);
}


.next-appointment-box h4 {
    font-size: 14px;
}


.next-appointment-box p {
    margin-top: 4px;

    color: var(--text-light);

    font-size: 10px;
}


.next-view-button {
    min-height: 36px;

    margin-top: 17px;

    padding: 0 13px;

    border: 1px solid #f9a8d4;

    border-radius: 9px;

    background: var(--white);

    color: var(--primary);

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    font-size: 10px;

    font-weight: 700;
}


.next-view-button svg {
    width: 14px;
}


.next-view-button:hover {
    background: var(--primary);

    color: var(--white);
}


/* ============================================================
   EMPTY STATE
============================================================ */

.dashboard-empty-state {
    min-height: 180px;

    padding: 30px 20px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    text-align: center;
}


.dashboard-empty-state.compact {
    min-height: 240px;
}


.empty-icon {
    width: 48px;
    height: 48px;

    border-radius: 13px;

    background: var(--background);

    color: var(--muted);

    display: flex;
    align-items: center;
    justify-content: center;
}


.empty-icon svg {
    width: 23px;
}


.dashboard-empty-state strong {
    margin-top: 11px;

    font-size: 12px;
}


.dashboard-empty-state span {
    margin-top: 4px;

    color: var(--text-light);

    font-size: 10px;
}


/* ============================================================
   PATIENT LIST
============================================================ */

.patient-list {
    padding: 6px 20px 12px;
}


.recent-patient {
    min-height: 64px;

    padding: 11px 0;

    display: flex;
    align-items: center;

    gap: 10px;

    border-bottom: 1px solid #f1f5f9;
}


.recent-patient:last-child {
    border-bottom: 0;
}


.recent-patient-info {
    min-width: 0;

    flex: 1;

    display: flex;
    flex-direction: column;
}


.recent-patient-info strong {
    font-size: 12px;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;
}


.recent-patient-info span {
    margin-top: 3px;

    color: var(--text-light);

    font-size: 9px;
}


.patient-view-button {
    width: 31px;
    height: 31px;

    flex-shrink: 0;

    border: 1px solid var(--border);

    border-radius: 8px;

    background: var(--white);

    color: var(--text-light);

    display: flex;
    align-items: center;
    justify-content: center;
}


.patient-view-button:hover {
    background: var(--primary-light);

    color: var(--primary);

    border-color: #f9a8d4;
}


.patient-view-button svg {
    width: 16px;
}


/* ============================================================
   LOWER GRID
============================================================ */

.lower-grid {
    grid-template-columns:
        minmax(0, 1.1fr)
        minmax(300px, 0.9fr);
}


/* ============================================================
   QUICK ACTIONS
============================================================ */

.quick-actions {
    padding: 8px 20px 15px;
}


.quick-action {
    min-height: 63px;

    padding: 10px 0;

    display: flex;
    align-items: center;

    gap: 11px;

    border-bottom: 1px solid #f1f5f9;
}


.quick-action:last-child {
    border-bottom: 0;
}


.quick-action-icon {
    width: 37px;
    height: 37px;

    flex-shrink: 0;

    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;
}


.quick-action-icon svg {
    width: 19px;
}


.quick-action-icon.blue {
    background: var(--blue-light);
    color: var(--blue);
}


.quick-action-icon.purple {
    background: var(--purple-light);
    color: var(--purple);
}


.quick-action-icon.green {
    background: var(--green-light);
    color: var(--green);
}


.quick-action-icon.orange {
    background: var(--orange-light);
    color: var(--orange);
}


.quick-action > div:nth-child(2) {
    flex: 1;

    min-width: 0;

    display: flex;
    flex-direction: column;
}


.quick-action strong {
    font-size: 11px;
}


.quick-action span {
    margin-top: 3px;

    color: var(--text-light);

    font-size: 9px;
}


.quick-arrow {
    width: 16px;

    flex-shrink: 0;

    color: var(--muted);
}


.quick-action:hover .quick-arrow {
    color: var(--primary);

    transform: translateX(2px);
}


/* ============================================================
   CLINIC SUMMARY
============================================================ */

.clinic-summary-card {
    padding: 20px;

    margin-top: 0;
}


.clinic-summary-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
}


.clinic-summary-header h3 {
    font-size: 15px;

    font-weight: 800;
}


.clinic-summary-header p {
    margin-top: 4px;

    color: var(--text-light);

    font-size: 10px;
}


.clinic-summary-header > strong {
    color: var(--primary);

    font-size: 12px;
}


.progress-container {
    margin-top: 20px;

    display: flex;
    align-items: center;

    gap: 12px;
}


.progress-track {
    flex: 1;

    height: 9px;

    background: #f1f5f9;

    border-radius: 999px;

    overflow: hidden;
}


.progress-fill {
    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            #f472b6
        );

    transition: width 0.6s ease;
}


.progress-container > span {
    min-width: 75px;

    color: var(--primary);

    font-size: 10px;

    font-weight: 700;

    text-align: right;
}


.progress-stats {
    margin-top: 18px;

    display: flex;

    align-items: center;

    gap: 25px;
}


.progress-stats > div {
    display: flex;
    align-items: center;

    gap: 6px;
}


.progress-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;
}


.progress-dot.pending {
    background: var(--orange);
}


.progress-dot.confirmed {
    background: var(--green);
}


.progress-dot.completed {
    background: var(--blue);
}


.progress-stats strong {
    font-size: 12px;
}


.progress-stats small {
    color: var(--text-light);

    font-size: 9px;
}


/* ============================================================
   MOBILE OVERLAY
============================================================ */

.sidebar-overlay {
    display: none;

    position: fixed;

    inset: 0;

    background: rgba(15, 23, 42, 0.45);

    z-index: 999;
}


/* ============================================================
   RESPONSIVE
============================================================ */

@media (max-width: 1200px) {

    .stats-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
        grid-template-columns:
            minmax(0, 1fr);
    }

    .next-card {
        min-height: auto;
    }

    .next-appointment-box {
        max-width: 450px;
    }

    .lower-grid {
        grid-template-columns:
            minmax(0, 1fr);
    }
}


@media (max-width: 900px) {

    .sidebar {
        transform: translateX(-100%);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .sidebar-close {
        display: flex;
    }

    .sidebar-overlay.active {
        display: block;
    }

    .main-content {
        width: 100%;
        margin-left: 0;
    }

    .mobile-menu-button {
        display: flex;
    }
}


@media (max-width: 700px) {

    .top-header {
        height: 72px;

        padding: 0 16px;
    }

    .header-profile-info {
        display: none;
    }

    .dashboard-body {
        padding: 20px 16px 30px;
    }

    .dashboard-intro {
        align-items: flex-start;

        flex-direction: column;
    }

    .dashboard-date {
        width: 100%;
    }

    .stats-grid {
        grid-template-columns: 1fr;

        gap: 12px;
    }

    .dashboard-appointment {
        grid-template-columns:
            62px
            minmax(0, 1fr);
    }

    .appointment-status {
        grid-column: 2;

        justify-self: start;

        margin-top: -5px;
    }

    .progress-stats {
        gap: 15px;

        flex-wrap: wrap;
    }
}


@media (max-width: 480px) {

    .page-title {
        font-size: 18px;
    }

    .page-subtitle {
        display: none;
    }

    .header-right {
        gap: 8px;
    }

    .header-icon-button {
        width: 36px;
        height: 36px;
    }

    .header-profile-avatar {
        width: 36px;
        height: 36px;
    }

    .dashboard-intro h2 {
        font-size: 19px;
    }

    .card-header {
        padding: 16px;
    }

    .appointment-list,
    .patient-list,
    .quick-actions {
        padding-left: 16px;
        padding-right: 16px;
    }

    .dashboard-appointment {
        grid-template-columns: 1fr;

        gap: 8px;
    }

    .appointment-status {
        grid-column: auto;
    }

    .clinic-summary-card {
        padding: 16px;
    }

    .clinic-summary-header {
        align-items: flex-start;

        flex-direction: column;
    }

    .progress-container {
        align-items: flex-start;

        flex-direction: column;
    }

    .progress-track {
        width: 100%;
    }

    .progress-container > span {
        text-align: left;
    }
}
/* ============================================================
   DENTIST HEADER
============================================================ */

.top-header {
    position: sticky;
    top: 0;
    z-index: 1000;

    width: 100%;
    height: 72px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 28px;

    background: #ffffff;

    border-bottom: 1px solid #e5e7eb;

    box-sizing: border-box;
}


/* ============================================================
   HEADER LEFT
============================================================ */

.header-left {
    display: flex;
    align-items: center;

    gap: 16px;

    min-width: 0;
}


/* ============================================================
   MOBILE MENU BUTTON
============================================================ */

.mobile-menu-button {
    width: 40px;
    height: 40px;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid #e5e7eb;
    border-radius: 9px;

    background: #ffffff;
    color: #374151;

    cursor: pointer;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
}

.mobile-menu-button:hover {
    background: #fff1f7;
    border-color: #f9a8d4;
    color: #db2777;
}

.mobile-menu-button:active {
    transform: scale(0.96);
}

.mobile-menu-button svg {
    width: 21px;
    height: 21px;

    display: block;
}


/* ============================================================
   PAGE TITLE
============================================================ */

.page-title {
    margin: 0;

    color: #172033;

    font-size: 21px;
    font-weight: 800;

    line-height: 1.25;

    letter-spacing: -0.02em;
}


/* ============================================================
   PAGE SUBTITLE
============================================================ */

.page-subtitle {
    margin: 4px 0 0;

    color: #7b8496;

    font-size: 12px;
    font-weight: 400;

    line-height: 1.4;
}


/* ============================================================
   HEADER RIGHT
============================================================ */

.header-right {
    display: flex;
    align-items: center;

    gap: 18px;
}


/* ============================================================
   HEADER ICON BUTTON
============================================================ */

.header-icon-button {
    position: relative;

    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid transparent;
    border-radius: 10px;

    background: transparent;
    color: #475467;

    cursor: pointer;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
}

.header-icon-button:hover {
    background: #fff1f7;

    border-color: #fce7f3;

    color: #db2777;
}

.header-icon-button:active {
    transform: scale(0.96);
}

.header-icon-button svg {
    width: 21px;
    height: 21px;

    display: block;
}


/* ============================================================
   NOTIFICATION BADGE
============================================================ */

.notification-badge {
    position: absolute;

    top: 3px;
    right: 2px;

    min-width: 17px;
    height: 17px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0 4px;

    border: 2px solid #ffffff;
    border-radius: 999px;

    background: #db2777;
    color: #ffffff;

    font-size: 8px;
    font-weight: 800;

    line-height: 1;
}


/* ============================================================
   HEADER PROFILE
============================================================ */

.header-profile {
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 5px 8px 5px 5px;

    border: 1px solid transparent;
    border-radius: 12px;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease;
}

.header-profile:hover {
    background: #fff7fb;

    border-color: #fce7f3;
}


/* ============================================================
   HEADER PROFILE AVATAR
============================================================ */

.header-profile-avatar {
    width: 40px;
    height: 40px;

    flex: 0 0 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border: 2px solid #fce7f3;
    border-radius: 50%;

    background: #db2777;

    color: #ffffff;

    font-size: 15px;
    font-weight: 800;
}


/* ============================================================
   PROFILE IMAGE
============================================================ */

.header-profile-avatar img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* ============================================================
   PROFILE INFORMATION
============================================================ */

.header-profile-info {
    min-width: 90px;

    display: flex;
    flex-direction: column;

    gap: 2px;
}


.header-profile-info strong {
    overflow: hidden;

    color: #172033;

    font-size: 12px;
    font-weight: 700;

    line-height: 1.3;

    text-overflow: ellipsis;
    white-space: nowrap;
}


.header-profile-info span {
    color: #98a2b3;

    font-size: 10px;
    font-weight: 500;

    line-height: 1.3;
}


/* ============================================================
   PROFILE CHEVRON
============================================================ */

.profile-chevron {
    width: 15px;
    height: 15px;

    flex: 0 0 15px;

    color: #98a2b3;

    transition:
        transform 0.2s ease,
        color 0.2s ease;
}

.header-profile:hover .profile-chevron {
    color: #db2777;
}


/* ============================================================
   NOTIFICATION WRAPPER
============================================================ */

.notification-wrapper {
    position: relative;
}


/* ============================================================
   NOTIFICATION DROPDOWN
============================================================ */

.notification-dropdown {
    position: absolute;

    top: calc(100% + 12px);
    right: 0;

    width: 360px;

    overflow: hidden;

    border: 1px solid #e5e7eb;
    border-radius: 14px;

    background: #ffffff;

    box-shadow:
        0 15px 40px rgba(15, 23, 42, 0.12);

    opacity: 0;
    visibility: hidden;

    transform: translateY(-8px);

    transition:
        opacity 0.2s ease,
        visibility 0.2s ease,
        transform 0.2s ease;

    z-index: 9999;
}


.notification-dropdown.show {
    opacity: 1;
    visibility: visible;

    transform: translateY(0);
}


/* ============================================================
   NOTIFICATION DROPDOWN HEADER
============================================================ */

.notification-dropdown-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 16px 18px;

    border-bottom: 1px solid #f0f0f0;
}


.notification-dropdown-header strong {
    color: #172033;

    font-size: 14px;
    font-weight: 800;
}


.notification-dropdown-header span {
    color: #98a2b3;

    font-size: 10px;
}


/* ============================================================
   NOTIFICATION LIST
============================================================ */

.notification-list {
    max-height: 350px;

    overflow-y: auto;
}


/* ============================================================
   NOTIFICATION ITEM
============================================================ */

.notification-item {
    display: flex;

    gap: 11px;

    padding: 13px 16px;

    border-bottom: 1px solid #f5f5f5;

    transition:
        background 0.2s ease;
}


.notification-item:hover {
    background: #fff8fb;
}


.notification-item.unread {
    background: #fff1f7;
}


/* ============================================================
   NOTIFICATION ICON
============================================================ */

.notification-item-icon {
    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: #fce7f3;

    color: #db2777;
}


.notification-item-icon svg {
    width: 17px;
    height: 17px;
}


/* ============================================================
   NOTIFICATION CONTENT
============================================================ */

.notification-item-content {
    min-width: 0;

    flex: 1;
}


.notification-item-content strong {
    display: block;

    margin-bottom: 3px;

    overflow: hidden;

    color: #172033;

    font-size: 12px;
    font-weight: 700;

    text-overflow: ellipsis;
    white-space: nowrap;
}


.notification-item-content p {
    margin: 0;

    color: #667085;

    font-size: 11px;

    line-height: 1.5;
}


.notification-item-content small {
    display: block;

    margin-top: 4px;

    color: #98a2b3;

    font-size: 9px;
}


/* ============================================================
   EMPTY NOTIFICATIONS
============================================================ */

.notification-empty {
    min-height: 150px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 9px;

    color: #98a2b3;

    font-size: 12px;
}


.notification-empty svg {
    width: 30px;
    height: 30px;
}


/* ============================================================
   CUSTOM SCROLLBAR
============================================================ */

.notification-list::-webkit-scrollbar {
    width: 5px;
}

.notification-list::-webkit-scrollbar-track {
    background: #f8fafc;
}

.notification-list::-webkit-scrollbar-thumb {
    border-radius: 10px;

    background: #f9a8d4;
}

.notification-list::-webkit-scrollbar-thumb:hover {
    background: #db2777;
}


/* ============================================================
   FOCUS STATES
============================================================ */

.mobile-menu-button:focus-visible,
.header-icon-button:focus-visible,
.header-profile:focus-visible {
    outline: 3px solid rgba(219, 39, 119, 0.18);

    outline-offset: 2px;
}


/* ============================================================
   RESPONSIVE - TABLET
============================================================ */

@media (max-width: 900px) {

    .top-header {
        padding: 0 20px;
    }

    .mobile-menu-button {
        display: flex;
    }

    .page-title {
        font-size: 18px;
    }

    .page-subtitle {
        font-size: 11px;
    }

}


/* ============================================================
   RESPONSIVE - MOBILE
============================================================ */

@media (max-width: 650px) {

    .top-header {
        height: 64px;

        padding: 0 14px;
    }


    .header-left {
        gap: 10px;
    }


    .mobile-menu-button {
        width: 38px;
        height: 38px;
    }


    .mobile-menu-button svg {
        width: 20px;
        height: 20px;
    }


    .page-title {
        font-size: 16px;
    }


    .page-subtitle {
        display: none;
    }


    .header-right {
        gap: 7px;
    }


    .header-icon-button {
        width: 38px;
        height: 38px;
    }


    .header-icon-button svg {
        width: 19px;
        height: 19px;
    }


    .header-profile {
        padding: 3px;
    }


    .header-profile-avatar {
        width: 36px;
        height: 36px;

        flex-basis: 36px;
    }


    .header-profile-info {
        display: none;
    }


    .profile-chevron {
        display: none;
    }


    .notification-dropdown {
        position: fixed;

        top: 70px;
        left: 12px;
        right: 12px;

        width: auto;
    }

}


/* ============================================================
   RESPONSIVE - SMALL MOBILE
============================================================ */

@media (max-width: 400px) {

    .top-header {
        padding: 0 10px;
    }


    .page-title {
        font-size: 15px;
    }


    .header-profile-avatar {
        width: 34px;
        height: 34px;

        flex-basis: 34px;
    }


    .notification-badge {
        top: 2px;
        right: 1px;
    }

}

.navigation-item {
    display: flex;
    align-items: center;
    gap: 12px;
}

.navigation-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.navigation-icon svg {
    width: 20px;
    height: 20px;
}

/* =========================================================
   LOGOUT MODAL
========================================================= */

.logout-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: flex;
    align-items: center;
    justify-content: center;
}

.logout-modal.hidden {
    display: none;
}


/* Overlay */

.logout-modal-overlay {
    position: absolute;
    inset: 0;

    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
}


/* Modal */

.logout-modal-content {
    position: relative;
    z-index: 2;

    width: min(420px, calc(100% - 32px));

    padding: 32px;

    background: #ffffff;

    border-radius: 20px;

    text-align: center;

    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);

    animation: logoutModalShow 0.25s ease;
}


@keyframes logoutModalShow {
    from {
        opacity: 0;
        transform: translateY(15px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


/* Icon */

.logout-modal-icon {
    width: 65px;
    height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0 auto 18px;

    background: #fff1f5;
    color: #e91e63;

    border-radius: 50%;
}

.logout-modal-icon svg {
    width: 30px;
    height: 30px;
}


/* Title */

.logout-modal-content h3 {
    margin: 0 0 10px;

    font-size: 22px;
    font-weight: 700;

    color: #1f2937;
}


/* Message */

.logout-modal-content p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
    line-height: 1.6;
}


/* Buttons */

.logout-modal-actions {
    display: flex;
    gap: 12px;

    margin-top: 28px;
}


.cancel-logout-btn,
.confirm-logout-btn {
    flex: 1;

    padding: 12px 18px;

    border-radius: 10px;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition: all 0.2s ease;
}


/* Cancel */

.cancel-logout-btn {
    background: #ffffff;

    color: #475569;

    border: 1px solid #d1d5db;
}

.cancel-logout-btn:hover {
    background: #f8fafc;

    transform: translateY(-1px);
}


/* Confirm */

.confirm-logout-btn {
    border: none;

    background: #e91e63;

    color: #ffffff;
}

.confirm-logout-btn:hover {
    background: #d81b60;

    transform: translateY(-1px);

    box-shadow: 0 8px 18px rgba(233, 30, 99, 0.25);
}


/* Mobile */

@media (max-width: 480px) {
    .logout-modal-content {
        padding: 24px;
    }

    .logout-modal-actions {
        flex-direction: column-reverse;
    }
}
