/* ============================================================
   SHINE & SMILE
   CUSTOMER CART
   ============================================================ */

.cart-page {
    width: min(1200px, 92%);

    margin: 0 auto;

    padding: 40px 0 70px;
}


/* ============================================================
   PAGE HEADER
   ============================================================ */

.cart-page-header {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 30px;

    margin-bottom: 30px;
}


.cart-label {
    display: inline-block;

    margin-bottom: 7px;

    color: #e91e63;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1.2px;
}


.cart-page-header h2 {
    margin-bottom: 6px;

    font-size: 32px;

    font-weight: 800;

    color: #2d2529;
}


.cart-page-header p {
    color: #766b70;

    font-size: 13px;
}


.continue-shopping {
    padding: 11px 17px;

    border: 1px solid #eadfe3;

    border-radius: 10px;

    background: white;

    color: #e91e63;

    font-size: 12px;

    font-weight: 700;

    transition: 0.2s ease;
}


.continue-shopping:hover {
    background: #fff0f5;

    border-color: #f8bbd0;
}


/* ============================================================
   CART LAYOUT
   ============================================================ */

.cart-layout {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        360px;

    gap: 24px;

    align-items: start;
}


/* ============================================================
   CART ITEMS SECTION
   ============================================================ */

.cart-items-section {
    min-width: 0;

    padding: 24px;

    border: 1px solid #eadfe3;

    border-radius: 18px;

    background: white;

    box-shadow:
        0 5px 20px
        rgba(40, 20, 30, 0.05);
}


.cart-section-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding-bottom: 18px;

    border-bottom: 1px solid #eadfe3;
}


.cart-section-header h3 {
    margin-bottom: 3px;

    font-size: 17px;

    font-weight: 800;
}


.cart-section-header span {
    color: #9a8f94;

    font-size: 11px;
}


.clear-cart-button {
    padding: 8px 12px;

    border-radius: 8px;

    background: #fff0f1;

    color: #dc3545;

    font-size: 11px;

    font-weight: 700;

    transition: 0.2s ease;
}


.clear-cart-button:hover {
    background: #ffe0e3;
}


/* ============================================================
   CART ITEM
   ============================================================ */

.cart-item {
    display: grid;

    grid-template-columns:
        75px
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 18px;

    padding: 20px 0;

    border-bottom: 1px solid #eadfe3;
}


.cart-item:last-child {
    border-bottom: 0;
}


/* ============================================================
   ITEM IMAGE
   ============================================================ */

.cart-item-image {
    width: 75px;

    height: 75px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #fff4f7,
            #ffe7ef
        );

    font-size: 36px;
}


/* ============================================================
   ITEM DETAILS
   ============================================================ */

.cart-item-details {
    min-width: 0;
}


.cart-item-category {
    display: inline-block;

    margin-bottom: 4px;

    padding: 3px 7px;

    border-radius: 50px;

    background: #fff0f5;

    color: #e91e63;

    font-size: 8px;

    font-weight: 800;

    text-transform: uppercase;
}


.cart-item-details h4 {
    margin-bottom: 3px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: 14px;

    font-weight: 750;
}


.cart-item-details p {
    margin-bottom: 5px;

    color: #9a8f94;

    font-size: 10px;
}


.cart-item-price {
    color: #e91e63;

    font-size: 13px;

    font-weight: 750;
}


/* ============================================================
   ITEM ACTIONS
   ============================================================ */

.cart-item-actions {
    display: flex;

    flex-direction: column;

    align-items: flex-end;

    gap: 9px;
}


.quantity-control {
    display: flex;

    align-items: center;

    overflow: hidden;

    border: 1px solid #eadfe3;

    border-radius: 8px;
}


.quantity-control button {
    width: 30px;

    height: 30px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #fff0f5;

    color: #e91e63;

    font-size: 16px;

    font-weight: 700;
}


.quantity-control button:hover {
    background: #fce4ec;
}


.quantity-control span {
    min-width: 34px;

    text-align: center;

    font-size: 12px;

    font-weight: 700;
}


.item-subtotal {
    color: #2d2529;

    font-size: 14px;

    font-weight: 800;
}


.remove-item {
    border: 0;

    background: transparent;

    color: #9a8f94;

    font-size: 10px;

    cursor: pointer;
}


.remove-item:hover {
    color: #dc3545;
}


/* ============================================================
   ORDER SUMMARY
   ============================================================ */

.order-summary {
    position: sticky;

    top: 100px;

    overflow: hidden;

    border: 1px solid #eadfe3;

    border-radius: 18px;

    background: white;

    box-shadow:
        0 8px 25px
        rgba(40, 20, 30, 0.07);
}


.summary-header {
    padding: 20px;

    border-bottom: 1px solid #eadfe3;
}


.summary-header h3 {
    font-size: 17px;

    font-weight: 800;
}


.summary-body {
    padding: 20px;
}


/* ============================================================
   SUMMARY ROW
   ============================================================ */

.summary-row {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 14px;
}


.summary-row span {
    color: #766b70;

    font-size: 12px;
}


.summary-row strong {
    color: #2d2529;

    font-size: 13px;
}


.summary-divider {
    height: 1px;

    margin: 18px 0;

    background: #eadfe3;
}


.total-row {
    margin-bottom: 20px;
}


.total-row span {
    color: #2d2529;

    font-size: 14px;

    font-weight: 750;
}


.total-row strong {
    color: #e91e63;

    font-size: 22px;

    font-weight: 800;
}


/* ============================================================
   DELIVERY BOX
   ============================================================ */

.delivery-box {
    display: flex;

    gap: 11px;

    margin-bottom: 20px;

    padding: 13px;

    border-radius: 11px;

    background: #fff7fa;

    border: 1px solid #fce4ec;
}


.delivery-icon {
    width: 34px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 8px;

    background: #fce4ec;

    font-size: 16px;
}


.delivery-box strong {
    display: block;

    margin-bottom: 3px;

    font-size: 11px;
}


.delivery-box p {
    color: #9a8f94;

    font-size: 9px;

    line-height: 1.4;
}


/* ============================================================
   CHECKOUT BUTTON
   ============================================================ */

.checkout-button {
    width: 100%;

    padding: 13px;

    border-radius: 10px;

    background: #e91e63;

    color: white;

    font-size: 13px;

    font-weight: 750;

    box-shadow:
        0 6px 15px
        rgba(233, 30, 99, 0.20);

    transition: 0.2s ease;
}


.checkout-button:hover:not(:disabled) {
    background: #c2185b;

    transform: translateY(-1px);
}


.checkout-button:disabled {
    background: #d7cfd2;

    box-shadow: none;

    cursor: not-allowed;
}


/* ============================================================
   CONTINUE SHOPPING
   ============================================================ */

.continue-link {
    display: block;

    margin-top: 13px;

    color: #e91e63;

    font-size: 11px;

    font-weight: 700;

    text-align: center;
}


/* ============================================================
   EMPTY CART
   ============================================================ */

.empty-cart {
    padding: 80px 20px;

    text-align: center;
}


.empty-cart-icon {
    width: 75px;

    height: 75px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin: 0 auto 16px;

    border-radius: 50%;

    background: #fff0f5;

    font-size: 35px;
}


.empty-cart h3 {
    margin-bottom: 6px;

    font-size: 18px;

    font-weight: 800;
}


.empty-cart p {
    margin-bottom: 20px;

    color: #9a8f94;

    font-size: 12px;
}


.browse-products-button {
    display: inline-block;

    padding: 11px 18px;

    border-radius: 9px;

    background: #e91e63;

    color: white;

    font-size: 12px;

    font-weight: 700;
}


.browse-products-button:hover {
    background: #c2185b;
}


/* ============================================================
   TOAST
   ============================================================ */

.toast {
    position: fixed;

    left: 50%;

    bottom: 25px;

    z-index: 5000;

    padding: 12px 18px;

    border-radius: 10px;

    background: #2d2529;

    color: white;

    font-size: 12px;

    font-weight: 600;

    opacity: 0;

    visibility: hidden;

    transform:
        translate(-50%, 15px);

    transition: 0.2s ease;
}


.toast.show {
    opacity: 1;

    visibility: visible;

    transform:
        translate(-50%, 0);
}


/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 900px) {

    .cart-layout {
        grid-template-columns: 1fr;
    }


    .order-summary {
        position: static;
    }

}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 600px) {

    .cart-page {
        width: 94%;

        padding-top: 25px;
    }


    .cart-page-header {
        align-items: flex-start;

        flex-direction: column;

        gap: 15px;
    }


    .cart-page-header h2 {
        font-size: 27px;
    }


    .cart-items-section {
        padding: 17px;
    }


    .cart-item {
        grid-template-columns:
            60px
            minmax(0, 1fr);

        gap: 12px;
    }


    .cart-item-image {
        width: 60px;

        height: 60px;

        font-size: 28px;
    }


    .cart-item-actions {
        grid-column: 2;

        align-items: flex-start;

        flex-direction: row;

        flex-wrap: wrap;
    }


    .item-subtotal {
        margin-left: auto;
    }


    .cart-section-header {
        align-items: flex-start;
    }

}


/* ============================================================
   SMALL MOBILE
   ============================================================ */

@media (max-width: 400px) {

    .cart-item-details h4 {
        font-size: 12px;
    }


    .cart-item-actions {
        gap: 6px;
    }


    .quantity-control button {
        width: 27px;

        height: 27px;
    }


    .quantity-control span {
        min-width: 28px;
    }

}

/* ============================================================
   SHINE & SMILE - PINK AND WHITE SHOPPING CART REDESIGN
   Appended overrides: preserves existing cart functionality
   ============================================================ */

:root {
    --cart-pink: #ed1763;
    --cart-pink-dark: #d90c55;
    --cart-pink-soft: #fff0f6;
    --cart-pink-border: #f6dce7;
    --cart-text: #28232a;
    --cart-muted: #817780;
    --cart-white: #ffffff;
}

/* Page background */
body {
    background: #fff8fb;
    color: var(--cart-text);
}

/* Main customer header */
.customer-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 4%;
    background: #ffffff;
    border-bottom: 1px solid var(--cart-pink-border);
    box-shadow: 0 3px 16px rgba(180, 40, 100, 0.04);
}

.brand {
    display: flex;
    align-items: center;
    gap: 13px;
}

.brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 15px;
    background: linear-gradient(135deg, #ffe0ee, #ffb9d6);
    font-size: 29px;
}

.brand h1 {
    margin: 0 0 4px;
    color: var(--cart-pink);
    font-size: 27px;
    font-weight: 850;
    letter-spacing: -0.6px;
}

.brand span {
    color: var(--cart-muted);
    font-size: 13px;
}

.customer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
}

.customer-nav .nav-link {
    color: #51464e;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: color .2s ease;
}

.customer-nav .nav-link:hover,
.customer-nav .nav-link:focus {
    color: var(--cart-pink);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 19px;
}

.cart-button {
    color: var(--cart-pink);
    text-decoration: none;
}

.cart-button span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 21px;
    height: 21px;
    padding: 0 5px;
    border-radius: 20px;
    background: var(--cart-pink);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
}

.profile-avatar {
    background: #ffe3ef;
    color: var(--cart-pink);
}

/* Cart page heading */
.cart-page {
    width: min(1450px, 94%);
    padding: 42px 0 75px;
}

.cart-page-header {
    align-items: center;
    margin-bottom: 34px;
}

.cart-label {
    color: var(--cart-pink);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 1.8px;
}

.cart-page-header h2 {
    margin: 8px 0;
    color: var(--cart-pink);
    font-size: clamp(29px, 3vw, 39px);
    font-weight: 850;
    letter-spacing: -1px;
}

.cart-page-header p {
    margin: 0;
    color: var(--cart-muted);
    font-size: 14px;
    line-height: 1.7;
}

.continue-shopping {
    padding: 13px 19px;
    border: 1px solid #ff8cba;
    border-radius: 11px;
    background: #fff;
    color: var(--cart-pink);
    font-size: 13px;
    font-weight: 750;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
}

.continue-shopping:hover {
    background: var(--cart-pink-soft);
    border-color: var(--cart-pink);
    transform: translateY(-1px);
}

/* Two-column cart layout */
.cart-layout {
    grid-template-columns: minmax(0, 1fr) 365px;
    gap: 25px;
    align-items: start;
}

/* White cart panel */
.cart-items-section {
    padding: 0 24px;
    overflow: hidden;
    border: 1px solid var(--cart-pink-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(126, 47, 81, .055);
}

.cart-section-header {
    min-height: 82px;
    padding: 20px 0;
    border-bottom: 1px solid #f2e7ec;
}

.cart-section-header h3 {
    margin: 0 0 6px;
    color: var(--cart-text);
    font-size: 17px;
    font-weight: 800;
}

.cart-section-header span {
    color: #a1949c;
    font-size: 12px;
}

.clear-cart-button {
    padding: 9px 13px;
    border: 1px solid #f4c6d8;
    border-radius: 8px;
    background: #fff5f9;
    color: var(--cart-pink);
    cursor: pointer;
    font-size: 11px;
    font-weight: 750;
}

.clear-cart-button:hover {
    background: #ffe5f0;
}

/* Dynamic cart items */
.cart-items {
    width: 100%;
}

.cart-item {
    grid-template-columns: 90px minmax(0, 1fr) auto;
    gap: 20px;
    padding: 25px 0;
    border-bottom: 1px solid #f2e7ec;
}

.cart-item-image {
    width: 90px;
    height: 90px;
    border: 1px solid #ffe1ed;
    border-radius: 13px;
    background: linear-gradient(145deg, #fff4f8, #ffe5f0);
    color: var(--cart-pink);
    overflow: hidden;
}

.cart-item-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.cart-item-category {
    padding: 4px 8px;
    border-radius: 20px;
    background: #ffe8f1;
    color: var(--cart-pink);
    font-size: 9px;
    letter-spacing: .2px;
}

.cart-item-details h4 {
    margin: 5px 0;
    color: var(--cart-text);
    font-size: 15px;
    font-weight: 800;
}

.cart-item-details p {
    color: var(--cart-muted);
    font-size: 12px;
    line-height: 1.6;
}

/* Common quantity controls */
.cart-item button,
.cart-item input {
    accent-color: var(--cart-pink);
}

.cart-item button {
    transition: background .2s ease, color .2s ease;
}

.cart-item button:hover {
    color: var(--cart-pink-dark);
}

/* Order summary card */
.order-summary {
    position: sticky;
    top: 20px;
    overflow: hidden;
    border: 1px solid var(--cart-pink-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(126, 47, 81, .055);
}

.summary-header {
    padding: 23px 24px;
    border-bottom: 1px solid #f2e7ec;
    background: #fff;
}

.summary-header h3 {
    margin: 0;
    color: var(--cart-text);
    font-size: 17px;
    font-weight: 850;
}

.summary-body {
    padding: 22px 24px 24px;
}

.summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
    color: var(--cart-muted);
    font-size: 13px;
}

.summary-row strong {
    color: var(--cart-text);
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
}

.summary-divider {
    height: 1px;
    margin: 20px 0;
    background: #f0e3e9;
}

.summary-row.total-row {
    align-items: center;
    margin: 0 0 22px;
    color: var(--cart-text);
    font-size: 15px;
    font-weight: 800;
}

.summary-row.total-row strong {
    color: var(--cart-pink);
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -.6px;
}

/* Delivery information */
.delivery-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 20px 0;
    padding: 14px;
    border: 1px solid #ffdfeb;
    border-radius: 12px;
    background: #fff5f9;
}

.delivery-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    flex-shrink: 0;
    border-radius: 10px;
    background: #ffe3ef;
    font-size: 19px;
}

.delivery-box strong {
    color: var(--cart-text);
    font-size: 12px;
    font-weight: 800;
}

.delivery-box p {
    margin: 5px 0 0;
    color: var(--cart-muted);
    font-size: 10px;
    line-height: 1.6;
}

/* Primary checkout button */
.checkout-button {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: 14px 18px;
    border: 0;
    border-radius: 11px;
    background: linear-gradient(100deg, #f51c70, #df0757);
    box-shadow: 0 6px 14px rgba(237, 23, 99, .18);
    color: #fff;
    cursor: pointer;
    font-size: 14px;
    font-weight: 850;
    transition: transform .2s ease, box-shadow .2s ease;
}

.checkout-button:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 20px rgba(237, 23, 99, .27);
}

.checkout-button:disabled {
    background: #efc5d6;
    box-shadow: none;
    cursor: not-allowed;
}

.continue-link {
    display: block;
    margin-top: 17px;
    color: var(--cart-pink);
    text-align: center;
    font-size: 12px;
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 3px;
}

.continue-link:hover {
    color: var(--cart-pink-dark);
}

/* Empty cart */
.empty-cart {
    padding: 48px 20px;
    text-align: center;
}

.empty-cart-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: #fff0f6;
    font-size: 32px;
}

.empty-cart h3 {
    margin-bottom: 9px;
    font-size: 18px;
    font-weight: 800;
}

.empty-cart p {
    margin-bottom: 20px;
    color: var(--cart-muted);
    font-size: 13px;
}

.browse-products-button {
    display: inline-block;
    padding: 12px 19px;
    border-radius: 9px;
    background: var(--cart-pink);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
}

/* Toast messages */
.toast {
    border: 1px solid var(--cart-pink-border);
    border-radius: 10px;
}

/* Tablet */
@media (max-width: 1000px) {
    .cart-layout {
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 18px;
    }

    .cart-items-section {
        padding: 0 18px;
    }

    .summary-body {
        padding: 20px 18px;
    }

    .cart-item {
        grid-template-columns: 75px minmax(0, 1fr) auto;
        gap: 13px;
    }

    .cart-item-image {
        width: 75px;
        height: 75px;
    }
}

/* Mobile */
@media (max-width: 760px) {
    .customer-header {
        flex-wrap: wrap;
        gap: 16px;
        padding: 16px 5%;
    }

    .brand h1 {
        font-size: 22px;
    }

    .brand-icon {
        width: 48px;
        height: 48px;
    }

    .customer-nav {
        order: 3;
        width: 100%;
        justify-content: flex-start;
        gap: 22px;
    }

    .header-actions {
        margin-left: auto;
    }

    .profile-info {
        display: none;
    }

    .cart-page {
        width: 92%;
        padding: 28px 0 45px;
    }

    .cart-page-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 18px;
    }

    .cart-page-header h2 {
        font-size: 30px;
