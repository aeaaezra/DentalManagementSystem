    background: #fff5d6 !important;
    border-color: #e8ad36 !important;
}

.order-status.processing {
    color: #1555a6 !important;
    background: #e8f3ff !important;
    border-color: #69a9ef !important;
}

.order-status.completed {
    color: #087443 !important;
    background: #e6f8ee !important;
    border-color: #61c58d !important;
}

.order-status.cancelled {
    color: #b42318 !important;
    background: #fff0ef !important;
    border-color: #f2a29c !important;
}

/* Outline only: preserve each badge's existing colors */
.order-status.pending {
    border: 1.5px solid #e8ad36 !important;
}

.order-status.processing {
    border: 1.5px solid #69a9ef !important;
}

.order-status.completed {
    border: 1.5px solid #61c58d !important;
}

.order-status.cancelled {
    border: 1.5px solid #f2a29c !important;
}

/* Force visible outlines on order status badges */
.order-card .order-status.pending {
    border: 2px solid #e8ad36 !important;
    box-shadow: 0 0 0 2px #fff0c2 !important;
}

.order-card .order-status.processing {
    border: 2px solid #69a9ef !important;
    box-shadow: 0 0 0 2px #dceeff !important;
}

.order-card .order-status.completed {
    border: 2px solid #61c58d !important;
    box-shadow: 0 0 0 2px #d9f5e5 !important;
}

.order-card .order-status.cancelled {
    border: 2px solid #f2a29c !important;
    box-shadow: 0 0 0 2px #ffe2df !important;
}

