/* ============================================================
   SHINE & SMILE
   CUSTOMER ORDERS
   ============================================================ */

.orders-page {
    width: min(1200px, 92%);

    margin: 0 auto;

    padding: 40px 0 70px;
}


/* ============================================================
   PAGE HEADER
   ============================================================ */

.orders-heading {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 25px;

    margin-bottom: 30px;
}


.orders-label {
    display: inline-block;

    margin-bottom: 7px;

    color: #e91e63;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1.2px;
}


.orders-heading h2 {
    margin-bottom: 5px;

    font-size: 32px;

    font-weight: 800;

    color: #2d2529;
}


.orders-heading p {
    color: #766b70;

    font-size: 13px;
}


/* ============================================================
   SHOP BUTTON
   ============================================================ */

.shop-products-button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    padding: 11px 17px;

    border-radius: 10px;

    background: #e91e63;

    color: white;

    font-size: 12px;

    font-weight: 700;

    box-shadow:
        0 6px 15px
        rgba(233, 30, 99, 0.18);

    transition: 0.2s ease;
}


.shop-products-button:hover {
    background: #c2185b;

    transform: translateY(-1px);
}


/* ============================================================
   STATISTICS
   ============================================================ */

.order-statistics {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;

    margin-bottom: 25px;
}


.order-stat-card {
    display: flex;

    align-items: center;

    gap: 13px;

    padding: 17px;

    border: 1px solid #eadfe3;

    border-radius: 14px;

    background: white;

    box-shadow:
        0 4px 15px
        rgba(40, 20, 30, 0.04);
}


.stat-icon {
    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 11px;

    font-size: 18px;
}


.stat-icon.all {
    background: #fff0f5;

    color: #e91e63;
}


.stat-icon.pending {
    background: #fff7df;

    color: #c58b00;
}


.stat-icon.processing {
    background: #eef5ff;

    color: #3977c5;
}


.stat-icon.completed {
    background: #ebf9f1;

    color: #2e9d68;
}


.order-stat-card span {
    display: block;

    margin-bottom: 2px;

    color: #9a8f94;

    font-size: 10px;
}


.order-stat-card strong {
    display: block;

    color: #2d2529;

    font-size: 20px;

    font-weight: 800;
}


/* ============================================================
   ORDERS SECTION
   ============================================================ */

.orders-section {
    padding: 23px;

    border: 1px solid #eadfe3;

    border-radius: 18px;

    background: white;

    box-shadow:
        0 5px 20px
        rgba(40, 20, 30, 0.05);
}


/* ============================================================
   TOOLBAR
   ============================================================ */

.orders-toolbar {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 22px;
}


.order-tabs {
    display: flex;

    align-items: center;

    gap: 6px;

    overflow-x: auto;
}


.order-tab {
    flex-shrink: 0;

    padding: 8px 13px;

    border: 1px solid #eadfe3;

    border-radius: 50px;

    background: white;

    color: #766b70;

    font-size: 11px;

    font-weight: 650;

    transition: 0.2s ease;
}


.order-tab:hover {
    background: #fff0f5;

    color: #e91e63;

    border-color: #f8bbd0;
}


.order-tab.active {
    background: #e91e63;

    color: white;

    border-color: #e91e63;
}


/* ============================================================
   SEARCH
   ============================================================ */

.order-search {
    position: relative;

    width: 230px;

    flex-shrink: 0;
}


.order-search span {
    position: absolute;

    left: 12px;

    top: 50%;

    transform: translateY(-50%);

    color: #9a8f94;

    font-size: 12px;
}


.order-search input {
    width: 100%;

    height: 38px;

    padding: 0 12px 0 35px;

    border: 1px solid #eadfe3;

    border-radius: 9px;

    outline: none;

    color: #2d2529;

    font-size: 11px;
}


.order-search input:focus {
    border-color: #e91e63;

    box-shadow:
        0 0 0 3px
        rgba(233, 30, 99, 0.07);
}


/* ============================================================
   ORDER CARD
   ============================================================ */

.order-card {
    padding: 20px;

    margin-bottom: 13px;

    border: 1px solid #eadfe3;

    border-radius: 14px;

    background: white;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}


.order-card:hover {
    border-color: #f8bbd0;

    box-shadow:
        0 6px 20px
        rgba(40, 20, 30, 0.06);
}


/* ============================================================
   ORDER CARD HEADER
   ============================================================ */

.order-card-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    padding-bottom: 15px;

    border-bottom: 1px solid #eadfe3;
}


.order-number {
    display: block;

    margin-bottom: 3px;

    color: #2d2529;

    font-size: 13px;

    font-weight: 800;
}


.order-date {
    color: #9a8f94;

    font-size: 10px;
}


/* ============================================================
   STATUS
   ============================================================ */

.order-status {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding: 5px 9px;

    border-radius: 50px;

    font-size: 9px;

    font-weight: 800;

    text-transform: capitalize;
}


.order-status::before {
    content: "";

    width: 6px;

    height: 6px;

    border-radius: 50%;

    background: currentColor;
}


.order-status.pending {
    background: #fff7df;

    color: #bd8700;
}


.order-status.processing {
    background: #eef5ff;

    color: #3977c5;
}


.order-status.completed {
    background: #ebf9f1;

    color: #2e9d68;
}


.order-status.cancelled {
    background: #fff0f1;

    color: #dc3545;
}


/* ============================================================
   ORDER PRODUCTS
   ============================================================ */

.order-products {
    padding: 15px 0;
}


.order-product {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 10px;
}


.order-product:last-child {
    margin-bottom: 0;
}


.order-product-icon {
    width: 45px;

    height: 45px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 9px;

    background: #fff5f8;

    font-size: 22px;
}


.order-product-info {
    flex: 1;

    min-width: 0;
}


.order-product-info strong {
    display: block;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    font-size: 12px;

    font-weight: 700;
}


.order-product-info span {
    color: #9a8f94;

    font-size: 10px;
}


.order-product-price {
    color: #2d2529;

    font-size: 12px;

    font-weight: 750;
}


/* ============================================================
   ORDER CARD FOOTER
   ============================================================ */

.order-card-footer {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding-top: 15px;

    border-top: 1px solid #eadfe3;
}


.order-items-count {
    color: #766b70;

    font-size: 10px;
}


.order-total {
    display: flex;

    align-items: center;

    gap: 8px;
}


.order-total span {
    color: #766b70;

    font-size: 10px;
}


.order-total strong {
    color: #e91e63;

    font-size: 16px;

    font-weight: 800;
}


.view-order-button {
    padding: 8px 12px;

    border: 1px solid #f8bbd0;

    border-radius: 8px;

    background: #fff0f5;

    color: #e91e63;

    font-size: 10px;

    font-weight: 700;

    cursor: pointer;

    transition: 0.2s ease;
}


.view-order-button:hover {
    background: #e91e63;

    color: white;
}


/* ============================================================
   EMPTY ORDERS
   ============================================================ */

.orders-empty {
    padding: 70px 20px;

    text-align: center;
}


.empty-orders-icon {
    width: 75px;

    height: 75px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin: 0 auto 15px;

    border-radius: 50%;

    background: #fff0f5;

    font-size: 35px;
}


.orders-empty h3 {
    margin-bottom: 5px;

    font-size: 18px;

    font-weight: 800;
}


.orders-empty p {
    margin-bottom: 18px;

    color: #9a8f94;

    font-size: 12px;
}


/* ============================================================
   ORDER MODAL
   ============================================================ */

.order-modal-overlay {
    position: fixed;

    inset: 0;

    z-index: 3000;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 20px;

    background:
        rgba(25, 15, 20, 0.52);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition: 0.2s ease;
}


.order-modal-overlay.show {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;
}


.order-modal {
    position: relative;

    width: min(620px, 100%);

    max-height: 90vh;

    overflow-y: auto;

    padding: 25px;

    border-radius: 18px;

    background: white;

    box-shadow:
        0 20px 50px
        rgba(20, 10, 15, 0.18);
}


/* ============================================================
   MODAL HEADER
   ============================================================ */

.order-modal-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    padding-bottom: 17px;

    border-bottom: 1px solid #eadfe3;
}


.order-modal-header span {
    color: #e91e63;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 1px;
}


.order-modal-header h2 {
    margin-top: 4px;

    font-size: 19px;

    font-weight: 800;
}


.modal-close {
    width: 34px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 9px;

    background: #fff0f5;

    color: #e91e63;

    font-size: 22px;

    cursor: pointer;
}


/* ============================================================
   MODAL STATUS
   ============================================================ */

.modal-status-row {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 17px 0;

    border-bottom: 1px solid #eadfe3;
}


.modal-status-row span {
    color: #766b70;

    font-size: 11px;
}


.modal-status-row strong {
    padding: 5px 9px;

    border-radius: 50px;

    background: #fff7df;

    color: #bd8700;

    font-size: 9px;
}


/* ============================================================
   ORDER TRACKER
   ============================================================ */

.order-tracker {
    display: flex;

    align-items: center;

    padding: 22px 5px;

    border-bottom: 1px solid #eadfe3;
}


.tracker-step {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 6px;

    flex-shrink: 0;
}


.tracker-circle {
    width: 31px;

    height: 31px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 2px solid #eadfe3;

    border-radius: 50%;

    background: white;

    color: #9a8f94;

    font-size: 10px;

    font-weight: 800;
}


.tracker-step.active .tracker-circle {
    border-color: #e91e63;

    background: #e91e63;

    color: white;
}


.tracker-step span {
    color: #766b70;

    font-size: 9px;

    white-space: nowrap;
}


.tracker-line {
    flex: 1;

    height: 2px;

    margin:
        0 8px
        17px;

    background: #eadfe3;
}


/* ============================================================
   MODAL ITEMS
   ============================================================ */

.modal-items {
    padding: 20px 0;
}


.modal-items h3 {
    margin-bottom: 12px;

    font-size: 13px;

    font-weight: 800;
}


.modal-item {
    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 0;

    border-bottom: 1px solid #f0e8eb;
}


.modal-item-icon {
    width: 38px;

    height: 38px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 8px;

    background: #fff5f8;

    font-size: 18px;
}


.modal-item-info {
    flex: 1;
}


.modal-item-info strong {
    display: block;

    font-size: 11px;
}


.modal-item-info span {
    color: #9a8f94;

    font-size: 9px;
}


.modal-item-price {
    font-size: 11px;

    font-weight: 750;
}


/* ============================================================
   MODAL TOTAL
   ============================================================ */

.modal-total {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 17px 0;

    border-top: 1px solid #eadfe3;

    border-bottom: 1px solid #eadfe3;
}


.modal-total span {
    font-size: 12px;

    font-weight: 700;
}


.modal-total strong {
    color: #e91e63;

    font-size: 20px;
}


/* ============================================================
   MODAL INFORMATION
   ============================================================ */

.modal-information {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 12px;

    padding-top: 18px;
}


.modal-information div {
    padding: 11px;

    border-radius: 9px;

    background: #fff7fa;
}


.modal-information span {
    display: block;

    margin-bottom: 4px;

    color: #9a8f94;

    font-size: 8px;

    text-transform: uppercase;
}


.modal-information strong {
    display: block;

    font-size: 10px;

    word-break: break-word;
}


/* ============================================================
   TOAST
   ============================================================ */

.toast {
    position: fixed;

    left: 50%;

    bottom: 25px;

    z-index: 5000;

    padding: 12px 18px;

    border-radius: 10px;

    background: #2d2529;

    color: white;

    font-size: 12px;

    font-weight: 600;

    opacity: 0;

    visibility: hidden;

    transform:
        translate(-50%, 15px);

    transition: 0.2s ease;
}


.toast.show {
    opacity: 1;

    visibility: visible;

    transform:
        translate(-50%, 0);
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 950px) {

    .order-statistics {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 750px) {

    .orders-heading {
        align-items: flex-start;

        flex-direction: column;
    }


    .orders-toolbar {
        align-items: stretch;

        flex-direction: column;
    }


    .order-search {
        width: 100%;
    }


    .order-tabs {
        padding-bottom: 3px;
    }

}


@media (max-width: 600px) {

    .orders-page {
        width: 94%;

        padding-top: 25px;
    }


    .order-statistics {
        grid-template-columns:
            repeat(2, 1fr);

        gap: 10px;
    }


    .order-stat-card {
        padding: 13px;

        gap: 9px;
    }


    .stat-icon {
        width: 35px;

        height: 35px;

        font-size: 15px;
    }


    .order-stat-card strong {
        font-size: 17px;
    }


    .orders-section {
        padding: 17px;
    }


    .order-card {
        padding: 15px;
    }


    .order-card-header {
        align-items: flex-start;

        flex-direction: column;

        gap: 10px;
    }


    .order-card-footer {
        align-items: flex-start;

        flex-direction: column;
    }


    .order-total {
        width: 100%;

        justify-content: space-between;
    }


    .view-order-button {
        width: 100%;
    }


    .modal-information {
        grid-template-columns: 1fr;
    }


    .order-modal {
        padding: 18px;
    }

}


@media (max-width: 400px) {

    .order-statistics {
        grid-template-columns: 1fr;
    }


    .orders-heading h2 {
        font-size: 27px;
    }

}

/* Request Cancellation - red button */
.request-cancellation-button {
    background-color: #dc2626 !important;
    color: #ffffff !important;
    border: 1px solid #dc2626 !important;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
}

.request-cancellation-button:hover {
    background-color: #b91c1c !important;
    border-color: #b91c1c !important;
}

.request-cancellation-button:disabled {
    background-color: #fca5a5 !important;
    border-color: #fca5a5 !important;
    color: #ffffff !important;
    cursor: not-allowed;
    opacity: 0.8;
}


/* ===== Pink Cancellation Modal ===== */
.cancellation-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(55, 25, 42, .65);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
}

.cancellation-modal-overlay.is-visible {
    display: flex;
}

.cancellation-modal {
    position: relative;
    width: min(100%, 560px);
    max-height: 90vh;
    overflow-y: auto;
    padding: 38px 30px 30px;
    border: 1px solid #ffd4e5;
    border-radius: 24px;
    background: linear-gradient(145deg, #fff 0%, #fff1f7 100%);
    box-shadow: 0 24px 80px rgba(95, 18, 54, .3);
    text-align: center;
    animation: cancellationModalIn .22s ease-out;
}

@keyframes cancellationModalIn {
    from { opacity: 0; transform: translateY(12px) scale(.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.cancellation-close {
    position: absolute;
    top: 13px;
    right: 15px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #ffe3ee;
    color: #d81b60;
    font-size: 28px;
    cursor: pointer;
}

.cancellation-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ffc0d9, #f062a0);
    font-size: 38px;
}

.cancellation-modal h2 {
    margin: 0 0 12px;
    color: #d81b60;
    font-size: clamp(23px, 4vw, 30px);
    font-weight: 800;
}

.cancellation-modal p {
    margin: 0 0 20px;
    color: #625364;
    line-height: 1.6;
}

.cancellation-modal textarea {
    display: block;
    width: 100%;
    min-height: 125px;
    padding: 15px;
    border: 2px solid #ffb4d1;
    border-radius: 16px;
    outline: none;
    background: #fff;
    color: #342431;
    font: inherit;
    resize: vertical;
}

.cancellation-modal textarea:focus {
    border-color: #ec3189;
    box-shadow: 0 0 0 4px rgba(236, 49, 137, .12);
}

.cancellation-modal-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
}

.cancellation-btn {
    min-width: 145px;
    padding: 13px 22px;
    border-radius: 999px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    transition: .2s ease;
}

.cancellation-btn:hover {
    transform: translateY(-2px);
}

.cancellation-btn-outline {
    border: 2px solid #ec3189;
    background: #fff;
    color: #d81b60;
}

.cancellation-btn-outline:hover {
    background: #fff0f6;
}

.cancellation-btn-primary {
    border: 2px solid #ec3189;
    background: linear-gradient(135deg, #ec3189, #d41465);
    color: #fff;
    box-shadow: 0 7px 18px rgba(216, 27, 96, .2);
}

.cancellation-btn-primary:hover {
    background: linear-gradient(135deg, #d81b60, #b91050);
}

.cancellation-btn:disabled {
    opacity: .6;
    cursor: not-allowed;
    transform: none;
}

@media (max-width: 480px) {
    .cancellation-modal {
        padding: 34px 20px 24px;
        border-radius: 20px;
    }

    .cancellation-modal-actions {
        flex-direction: column-reverse;
    }

    .cancellation-btn {
        width: 100%;
    }
}


/* Cancellation request success modal */
.cancel-success-overlay {
    position: fixed;
    inset: 0;
    z-index: 10050;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(45, 25, 36, 0.48);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .22s ease, visibility .22s ease;
}
.cancel-success-overlay.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}
.cancel-success-card {
    position: relative;
    width: min(100%, 430px);
    padding: 36px 30px 30px;
    border: 1px solid #f8d8e7;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 22px 70px rgba(111, 25, 66, .22);
    text-align: center;
    transform: translateY(12px) scale(.98);
    transition: transform .22s ease;
}
.cancel-success-overlay.is-visible .cancel-success-card {
    transform: translateY(0) scale(1);
}
.cancel-success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #ffe5f0;
    color: #ed2380;
    font-size: 38px;
    font-weight: 700;
}
.cancel-success-card h2 {
    margin: 0 0 12px;
    color: #29202a;
    font-size: 25px;
    font-weight: 750;
}
.cancel-success-card p {
    margin: 0 0 25px;
    color: #746672;
    font-size: 15px;
    line-height: 1.7;
}
.cancel-success-button {
    min-width: 120px;
    padding: 12px 28px;
    border: 0;
    border-radius: 10px;
    background: #ed2380;
    color: #fff;
    font: inherit;
