
:root {
    --sh-pink: #e91e63;
    --sh-pink-light: #fff1f5;
    --sh-text: #242124;
    --sh-muted: #77717a;
    --sh-border: #f0e7eb;
    --sh-surface: #ffffff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    color: var(--sh-text);
    font-family: Inter, Arial, sans-serif;
}

.sh-sales-page {
    width: min(1500px, 100%);
    margin: 0 auto;
    padding: 32px;
}

.sh-sales-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.sh-eyebrow {
    color: var(--sh-pink);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.sh-sales-header h1 {
    margin: 8px 0;
    font-size: clamp(26px, 3vw, 36px);
}

.sh-muted {
    color: var(--sh-muted);
    margin: 0;
}

.sh-sales-card {
    overflow: hidden;
    background: var(--sh-surface);
    border: 1px solid var(--sh-border);
    border-radius: 16px;
    box-shadow: 0 8px 30px rgba(40, 20, 30, 0.04);
}

.sh-sales-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 20px;
    border-bottom: 1px solid var(--sh-border);
}

.sh-sales-filters input,
.sh-sales-filters select {
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--sh-border);
    border-radius: 9px;
    background: #fff;
    font: inherit;
}

.sh-sales-filters input {
    flex: 1 1 240px;
}

.sh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 10px 16px;
    border: 0;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
}

.sh-btn-primary {
    color: #fff;
    background: var(--sh-pink);
}

.sh-btn-light {
    color: var(--sh-text);
    background: var(--sh-pink-light);
}

.sh-table-wrap {
    width: 100%;
    overflow-x: auto;
}

.sh-sales-table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
}

.sh-sales-table th,
.sh-sales-table td {
    padding: 16px 18px;
    text-align: left;
    border-bottom: 1px solid var(--sh-border);
}

.sh-sales-table th {
    background: #fff8fa;
    color: #756671;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.sh-sales-table tbody tr:hover {
    background: #fffafd;
}

.sh-status {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    background: #f3f4f6;
    font-size: 12px;
    font-weight: 700;
}

.sh-status-completed {
    color: #166534;
    background: #dcfce7;
}

.sh-status-pending {
    color: #92400e;
    background: #fef3c7;
}

.sh-status-cancelled {
    color: #991b1b;
    background: #fee2e2;
}

.sh-empty {
    padding: 48px 20px !important;
    text-align: center !important;
    white-space: normal;
}

.sh-empty p {
    color: var(--sh-muted);
}

.sh-pagination {
    padding: 20px;
}

@media (max-width: 700px) {
    .sh-sales-page {
        padding: 16px;
    }

    .sh-sales-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .sh-sales-filters {
        padding: 14px;
    }

    .sh-sales-filters input,
    .sh-sales-filters select {
        width: 100%;
        flex-basis: 100%;
    }
}


/* ===== SALES HISTORY TABLE IMPROVEMENTS ===== */

.sh-sales-card {
    border: 1px solid #ead6df;
    border-radius: 16px;
}

.sh-table-wrap {
    border-top: 1px solid #ead6df;
}

.sh-sales-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    white-space: nowrap;
}

.sh-sales-table th,
.sh-sales-table td {
    padding: 16px 18px;
    border-right: 1px solid #f0e1e8;
    border-bottom: 1px solid #ead6df;
}

.sh-sales-table th:first-child,
.sh-sales-table td:first-child {
    border-left: 1px solid #ead6df;
}

.sh-sales-table th {
    background: #fff3f7;
    color: #71334d;
    font-weight: 800;
    border-top: 1px solid #ead6df;
}

.sh-sales-table tbody tr:nth-child(even) {
    background: #fffafd;
}

.sh-sales-table tbody tr:hover {
    background: #fff0f5;
}

.sh-sales-table tbody tr:last-child td {
    border-bottom: 1px solid #ead6df;
}

.sh-sales-table td strong {
    color: #29212a;
}

.sh-sales-filters input:focus,
.sh-sales-filters select:focus {
    outline: none;
    border-color: var(--sh-pink);
    box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.12);
}

.sh-btn {
    transition: background-color .2s ease, transform .2s ease;
}

.sh-btn-primary:hover {
    background: #c91652;
}

.sh-btn-light:hover {
    background: #ffe0eb;
}

/* ===== PAGINATION ===== */

.sh-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 20px;
    border-top: 1px solid #ead6df;
    background: #fffafd;
}

.sh-pagination nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    width: 100%;
}

.sh-pagination nav > div {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
}

.sh-pagination a,
.sh-pagination span[aria-current="page"] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid #ead6df;
    border-radius: 9px;
    background: #fff;
    color: #71334d;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: all .2s ease;
}

.sh-pagination a:hover {
    border-color: var(--sh-pink);
    background: var(--sh-pink-light);
    color: var(--sh-pink);
}

.sh-pagination span[aria-current="page"] {
    border-color: var(--sh-pink);
    background: var(--sh-pink);
    color: #fff;
}

.sh-pagination span[aria-disabled="true"] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid #eee3e8;
    border-radius: 9px;
    background: #f8f5f6;
    color: #aaa0a6;
    font-size: 13px;
}

.sh-pagination svg {
    width: 16px;
    height: 16px;
}

@media (max-width: 700px) {
    .sh-pagination {
        padding: 14px;
    }

    .sh-pagination nav {
        align-items: flex-start;
    }

    .sh-sales-table th,
    .sh-sales-table td {
        padding: 12px;
    }
}

/* Clear borders for every Sales History table cell */
.sh-table-wrap {
    border: 1px solid #e5cbd7;
    border-radius: 8px;
    overflow-x: auto;
}

.sh-sales-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #e5cbd7;
}

.sh-sales-table th,
.sh-sales-table td {
    border: 1px solid #e5cbd7 !important;
    padding: 16px 18px;
}

.sh-sales-table th {
    background: #fff0f5;
    color: #71334d;
}

.sh-sales-table tbody tr:hover {
    background: #fff3f7;
}

.sh-sales-table tbody tr:last-child td {
    border-bottom: 1px solid #e5cbd7 !important;
}
