}

@media (max-width: 600px) {

    .notification-dropdown {
        position: fixed;

        top: 72px;
        right: 15px;
        left: 15px;

        width: auto;
        max-width: none;
    }

}
/* =========================================================
   POS TOPBAR HEADER FIX
   ========================================================= */

.topbar {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 82px;
}

.topbar .search-wrap {
    flex: 1 1 auto;
    min-width: 0;
}

.top-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    flex-shrink: 0;
}

/* Theme + Notification buttons */
.top-actions > .icon-button,
.top-actions .notification-wrapper > .icon-button {
    width: 42px;
    height: 42px;
    min-width: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

/* Notification wrapper */
.notification-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

/* Register information */
.top-actions .register {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    min-width: 90px;
    line-height: 1.2;
}

.top-actions .register span {
    display: block;
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
}

.top-actions .register strong {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #12a66a;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.top-actions .register strong i {
    font-size: 8px;
    color: #12a66a;
}

/* Cashier information */
.top-actions .cashier {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 150px;
    padding-left: 4px;
}

.top-actions .cashier .avatar {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--pink);
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
}

.top-actions .cashier > div:nth-child(2) {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
}

.top-actions .cashier > div:nth-child(2) strong {
    display: block;
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
}

.top-actions .cashier > div:nth-child(2) span {
    display: block;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.2;
    white-space: nowrap;
}

.top-actions .cashier > i {
    margin-left: 4px;
    color: var(--text);
    font-size: 12px;
    flex-shrink: 0;
}

/* Notification dropdown stays attached to the bell */
.notification-dropdown {
    top: calc(100% + 10px);
    right: 0;
}

/* =========================================================
   TOPBAR RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {

    .topbar {
        gap: 12px;
    }

    .top-actions {
        gap: 9px;
    }

    .top-actions .register {
        min-width: 80px;
    }

    .top-actions .cashier {
        min-width: 125px;
    }

    .top-actions .cashier .avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
    }

}

@media (max-width: 850px) {

    .topbar {
        gap: 10px;
    }

    .top-actions .register {
        display: none;
    }

    .top-actions .cashier {
        min-width: auto;
    }

    .top-actions .cashier > div:nth-child(2) {
        display: none;
    }

    .top-actions .cashier > i {
        display: none;
    }

}

@media (max-width: 600px) {

    .topbar {
        min-height: 68px;
        gap: 8px;
    }

    .top-actions {
        gap: 6px;
    }

    .top-actions > .icon-button,
    .top-actions .notification-wrapper > .icon-button {
        width: 38px;
        height: 38px;
        min-width: 38px;
    }

    .top-actions .cashier .avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        font-size: 13px;
    }

}
/* =========================================================
   CASHIER PROFILE DROPDOWN
   ========================================================= */

.cashier-menu {
    position: relative;
    flex-shrink: 0;
}

.cashier-menu .cashier {
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: inherit;
}

.cashier-menu .cashier:focus {
    outline: none;
}

.cashier-menu .cashier-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
}

.cashier-menu .cashier-info strong {
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
}

.cashier-menu .cashier-info span {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.2;
}

.cashier-menu .cashier-chevron {
    color: var(--text);
    font-size: 11px;
    margin-left: 4px;
    transition: transform .2s ease;
}

.cashier-menu.active .cashier-chevron {
    transform: rotate(180deg);
}

/* Dropdown */
.cashier-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 240px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
    padding: 8px;
    z-index: 10000;

    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    pointer-events: none;

    transition:
        opacity .18s ease,
        transform .18s ease,
        visibility .18s ease;
}

.cashier-menu.active .cashier-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
}

/* User information */
.cashier-dropdown-user {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
}

.cashier-dropdown-avatar {
    width: 42px;
    height: 42px;
    min-width: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--pink);
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
}

.cashier-dropdown-user > div:last-child {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.cashier-dropdown-user strong {
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
}

.cashier-dropdown-user span {
    color: var(--muted);
    font-size: 11px;
}

/* Divider */
.cashier-dropdown-divider {
    height: 1px;
    background: var(--border);
    margin: 6px 4px;
}

/* Menu items */
.cashier-dropdown-item {
    width: 100%;
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 11px;

    padding: 10px 11px;

    border: 0;
    border-radius: 10px;

    background: transparent;

    color: var(--text);
    text-decoration: none;

    font-family: inherit;
    font-size: 13px;
    font-weight: 600;

    cursor: pointer;
    text-align: left;

    box-sizing: border-box;
}

.cashier-dropdown-item:hover {
    background: var(--pink-pale);
    color: var(--pink);
}

.cashier-dropdown-item i {
    width: 18px;
    text-align: center;
    color: var(--muted);
}

.cashier-dropdown-item:hover i {
    color: var(--pink);
}

.cashier-dropdown-item.logout-item {
    color: #ef4444;
}

.cashier-dropdown-item.logout-item i {
    color: #ef4444;
}

.cashier-dropdown-item.logout-item:hover {
    background: rgba(239, 68, 68, .08);
    color: #dc2626;
}

/* Mobile */
@media (max-width: 850px) {

    .cashier-dropdown {
        right: 0;
        width: 220px;
    }

}

@media (max-width: 600px) {

    .cashier-dropdown {
        position: fixed;
        top: 68px;
        right: 12px;
        width: 230px;
    }

}
