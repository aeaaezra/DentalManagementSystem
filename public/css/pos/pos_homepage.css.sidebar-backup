/* =========================================================
   FIXED POS CART / CURRENT ORDER UI
   ========================================================= */

.cart-list {
    width: 100%;
    box-sizing: border-box;
    padding: 4px 16px;
    overflow-y: auto;
}

.cart-item {
    width: 100%;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
        "info controls"
        "info total";

    column-gap: 14px;
    row-gap: 7px;

    padding: 14px 0;
    margin: 0;

    border-bottom: 1px solid var(--border);
    background: transparent;

    min-width: 0;
}

/* PRODUCT INFORMATION */

.cart-item-info {
    grid-area: info;

    min-width: 0;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;

    overflow: hidden;
}

.cart-item-info h4 {
    width: 100%;
    margin: 0;

    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;

    white-space: normal;
    overflow-wrap: anywhere;
}

.cart-item-info span {
    display: block;

    margin-top: 4px;

    color: var(--muted);
    font-size: 11px;
    line-height: 1.3;
}

/* QUANTITY AREA */

.cart-item .quantity-controls {
    grid-area: controls;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 5px;

    white-space: nowrap;
}

.quantity-button {
    width: 30px;
    height: 30px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid var(--border);
    border-radius: 7px;

    background: var(--surface);
    color: var(--text);

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    transition:
        background .15s ease,
        border-color .15s ease,
        color .15s ease;
}

.quantity-button:hover {
    background: var(--pink-soft);
    border-color: var(--pink);
    color: var(--pink);
}

.quantity-button:active {
    transform: scale(.96);
}

/* QUANTITY NUMBER */

.cart-item .quantity,
.cart-item .quantity-value {
    min-width: 24px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: var(--text);

    font-size: 13px;
    font-weight: 700;

    text-align: center;
}

/* REMOVE BUTTON */

.remove-cart-button {
    width: 30px;
    height: 30px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-left: 3px;
    padding: 0;

    border: 1px solid #f1dce4;
    border-radius: 7px;

    background: transparent;
    color: #e14d72;

    cursor: pointer;

    transition:
        background .15s ease,
        color .15s ease,
        border-color .15s ease;
}

.remove-cart-button:hover {
    background: #fff0f3;
    border-color: #e14d72;
    color: #c92f57;
}

/* ITEM TOTAL */

.cart-item-total {
    grid-area: total;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    color: var(--pink);

    font-size: 13px;
    font-weight: 800;

    white-space: nowrap;
}

/* =========================================================
   DARK MODE CART
   ========================================================= */

html.dark-mode .cart-item {
    border-bottom-color: var(--border);
}

html.dark-mode .quantity-button {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text);
}

html.dark-mode .quantity-button:hover {
    background: var(--pink-soft);
    border-color: var(--pink);
    color: var(--pink);
}

html.dark-mode .remove-cart-button {
    background: transparent;
    border-color: var(--border);
    color: #ff6b91;
}

html.dark-mode .remove-cart-button:hover {
    background: var(--pink-soft);
    border-color: #ff6b91;
}

